@setup anchored_aggregate_rows
test anchored-agg-a6-l2-f2 {
    SELECT o.id, (SELECT total(i.amount) FROM inner_rows i WHERE i.key1 = o.key1 AND i.key2 = o.key2 AND i.amount >= 7)
    FROM outer_rows o ORDER BY o.id;
}
expect {
    1|30.0
    2|30.0
    3|0.0
    4|0.0
    5|0.0
    6|0.0
}

