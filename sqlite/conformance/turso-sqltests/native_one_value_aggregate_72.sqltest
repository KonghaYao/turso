@database :memory:

# All source one-value-aggregate matrix SQL; independently computed fixed rows.
setup anchored_aggregate_rows {
    CREATE TABLE outer_rows(
        id INTEGER PRIMARY KEY,
        key1 INTEGER,
        key2 INTEGER,
        amount INTEGER,
        text_key TEXT
    );
    CREATE TABLE inner_rows(key1 INTEGER, key2 INTEGER, amount INTEGER, text_key TEXT);
    CREATE TABLE outer_key2(id INTEGER PRIMARY KEY, key2 INTEGER);
    INSERT INTO outer_rows VALUES
        (1, 1, 10, 5, 'A'),
        (2, 1, 10, 15, 'a'),
        (3, 2, 20, 7, 'B'),
        (4, 3, 30, 9, 'C'),
        (5, NULL, 40, 4, NULL),
        (6, 2, NULL, NULL, 'b');
    INSERT INTO inner_rows VALUES
        (1, 10, 10, 'a'),
        (1, 10, 20, 'A'),
        (1, 99, 100, 'x'),
        (2, 20, 6, 'b'),
        (2, 20, NULL, 'B'),
        (2, NULL, 7, NULL),
        (NULL, 40, 99, NULL);
    INSERT INTO outer_key2 VALUES (1, 10), (3, 20), (5, 40);
}

@setup anchored_aggregate_rows
test anchored-agg-a0-l0-f0 {
    SELECT o.id, (SELECT avg(i.amount) FROM inner_rows i WHERE i.key1 = o.key1 )
    FROM outer_rows o ORDER BY o.id;
}
expect {
    1|43.3333333333333
    2|43.3333333333333
    3|6.5
    4|
    5|
    6|6.5
}

@setup anchored_aggregate_rows
test anchored-agg-a0-l0-f1 {
    SELECT o.id, (SELECT avg(i.amount) FROM inner_rows i WHERE i.key1 = o.key1 AND i.amount IS NOT NULL)
    FROM outer_rows o ORDER BY o.id;
}
expect {
    1|43.3333333333333
    2|43.3333333333333
    3|6.5
    4|
    5|
    6|6.5
}

@setup anchored_aggregate_rows
test anchored-agg-a0-l0-f2 {
    SELECT o.id, (SELECT avg(i.amount) FROM inner_rows i WHERE i.key1 = o.key1 AND i.amount >= 7)
    FROM outer_rows o ORDER BY o.id;
}
expect {
    1|43.3333333333333
    2|43.3333333333333
    3|7.0
    4|
    5|
    6|7.0
}

