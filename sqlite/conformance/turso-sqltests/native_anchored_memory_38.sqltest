@setup anchored_prefix
test anchored-prefix-j0-f0 {
    SELECT parent.id, child.group_id, child.payload
    FROM prefix_parent AS parent
    JOIN prefix_child AS child
      ON child.parent_id = parent.id AND child.group_id > 15
    WHERE parent.selected = 1
    ORDER BY parent.id, child.group_id, child.payload;
}
expect {
    1|20|9
    2|30|8
    3|40|-5
}

@setup anchored_prefix
test anchored-prefix-j0-f1 {
    SELECT parent.id, child.group_id, child.payload
    FROM prefix_parent AS parent
    JOIN prefix_child AS child
      ON child.parent_id = parent.id AND child.group_id IN (10, 20)
    WHERE parent.selected = 1
    ORDER BY parent.id, child.group_id, child.payload;
}
expect {
    1|10|-1
    1|20|9
}

@setup anchored_prefix
test anchored-prefix-j0-f2 {
    SELECT parent.id, child.group_id, child.payload
    FROM prefix_parent AS parent
    JOIN prefix_child AS child
      ON child.parent_id = parent.id AND child.group_id = 10
    WHERE parent.selected = 1
    ORDER BY parent.id, child.group_id, child.payload;
}
expect {
    1|10|-1
}

