@database :memory:

# Native-only fixed results for the two original join/memory matrices.
# Expected rows come solely from frozen INSERTs and Python enumeration.
setup anchored_indexed_orders {
    CREATE TABLE expression_build_orders(
        id INTEGER PRIMARY KEY,
        customer_id INTEGER,
        order_date TEXT
    );
    CREATE INDEX expression_build_order_key
        ON expression_build_orders(customer_id, lower(order_date));
    CREATE TABLE expression_build_inventory(product_id INTEGER, quantity INTEGER);
    INSERT INTO expression_build_orders VALUES
        (1, 100, 'ABC'), (2, 100, 'DeF'), (3, 100, NULL),
        (4, 200, 'GHI'), (6, 100, 'xyz');
    INSERT INTO expression_build_inventory VALUES
        (1, 2), (1, 3), (2, 4), (3, 5), (5, 6);

    CREATE TABLE covering_build_orders(
        id INTEGER PRIMARY KEY,
        customer_id INTEGER,
        order_date TEXT
    );
    INSERT INTO covering_build_orders SELECT * FROM expression_build_orders;
    CREATE INDEX covering_build_order_key
        ON covering_build_orders(customer_id, order_date);

    CREATE TABLE expression_covering_build_orders(
        id INTEGER PRIMARY KEY,
        customer_id INTEGER,
        order_date TEXT
    );
    INSERT INTO expression_covering_build_orders SELECT * FROM expression_build_orders;
    CREATE INDEX expression_covering_build_order_key
        ON expression_covering_build_orders(customer_id, lower(order_date), order_date);

    CREATE TABLE noncovering_build_orders(
        id INTEGER PRIMARY KEY,
        customer_id INTEGER,
        order_date TEXT
    );
    INSERT INTO noncovering_build_orders SELECT * FROM expression_build_orders;
    CREATE INDEX noncovering_build_order_key
        ON noncovering_build_orders(customer_id);

    CREATE TABLE partial_build_orders(
        id INTEGER PRIMARY KEY,
        customer_id INTEGER,
        order_date TEXT
    );
    INSERT INTO partial_build_orders SELECT * FROM expression_build_orders;
    CREATE INDEX partial_build_order_key
        ON partial_build_orders(customer_id, order_date)
        WHERE customer_id = 100;

    CREATE TABLE expression_build_customers(id INTEGER PRIMARY KEY, enabled INTEGER);
    INSERT INTO expression_build_customers VALUES (100, 1), (200, 0);
}

setup anchored_prefix {
    CREATE TABLE prefix_parent(id INTEGER PRIMARY KEY, selected INTEGER);
    CREATE TABLE prefix_child(group_id INTEGER, parent_id INTEGER, payload INTEGER,
        PRIMARY KEY(group_id, parent_id));
    CREATE INDEX prefix_child_positive
        ON prefix_child(group_id, parent_id) WHERE payload > 0;
    INSERT INTO prefix_parent VALUES (1, 1), (2, 1), (3, 1), (4, 0);
    INSERT INTO prefix_child VALUES
        (10, 1, -1), (20, 1, 9), (30, 2, 8), (40, 3, -5), (50, NULL, 6);
    ANALYZE;
    DELETE FROM sqlite_stat1;
    INSERT INTO sqlite_stat1(tbl, idx, stat) VALUES
        ('prefix_parent', NULL, '1000'),
        ('prefix_child', NULL, '5000000'),
        ('prefix_child', 'sqlite_autoindex_prefix_child_1', '5000000 5000 1'),
        ('prefix_child', 'prefix_child_positive', '5000000 5000 1');
    ANALYZE sqlite_schema;
}

@setup anchored_indexed_orders
test anchored-build-b0-j0-d0 {
    SELECT orders.id, orders.order_date, inventory.quantity
    FROM expression_build_orders AS orders
    JOIN expression_build_inventory AS inventory
      ON orders.id = inventory.product_id
    WHERE orders.customer_id = 100 OR orders.id IS NULL
    ORDER BY orders.id, inventory.quantity;
}
expect {
    1|ABC|2
    1|ABC|3
    2|DeF|4
    3||5
}

@setup anchored_indexed_orders
test anchored-build-b0-j0-d1 {
    SELECT orders.id, lower(orders.order_date), inventory.quantity
    FROM expression_build_orders AS orders
    JOIN expression_build_inventory AS inventory
      ON orders.id = inventory.product_id
    WHERE orders.customer_id = 100 OR orders.id IS NULL
    ORDER BY orders.id, inventory.quantity;
}
expect {
    1|abc|2
    1|abc|3
    2|def|4
    3||5
}

