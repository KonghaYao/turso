@database :memory:

# 108 exact original SQL expansions; unordered multiset comparison due peer tie ordering.
setup anchored_shapes {
    CREATE TABLE t(p INT, k INT);
    INSERT INTO t VALUES (1,NULL),(1,1),(1,1),(1,3),(1,4),(1,4),(2,7);
}

@setup anchored_shapes
test anchored-window-desc-m0-s0-e0-n0-x0 {
    SELECT p, k, sum(k) OVER w, count(*) OVER w, group_concat(k,',') OVER w, first_value(k) OVER w, last_value(k) OVER w FROM t WINDOW w AS (PARTITION BY p ORDER BY k DESC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW ) ORDER BY p, k DESC NULLS FIRST;
}
expect unordered {
    1|||1|||
    1|4|4|2|4||4
    1|4|8|3|4,4||4
    1|3|11|4|4,4,3||3
    1|1|12|5|4,4,3,1||1
    1|1|13|6|4,4,3,1,1||1
    2|7|7|1|7|7|7
}

@setup anchored_shapes
test anchored-window-desc-m0-s0-e0-n0-x1 {
    SELECT p, k, sum(k) OVER w, count(*) OVER w, group_concat(k,',') OVER w, first_value(k) OVER w, last_value(k) OVER w FROM t WINDOW w AS (PARTITION BY p ORDER BY k DESC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES) ORDER BY p, k DESC NULLS FIRST;
}
expect unordered {
    1|||1|||
    1|4|4|2|4||4
    1|4|4|2|4||4
    1|3|11|4|4,4,3||3
    1|1|12|5|4,4,3,1||1
    1|1|12|5|4,4,3,1||1
    2|7|7|1|7|7|7
}

@setup anchored_shapes
test anchored-window-desc-m0-s0-e0-n1-x0 {
    SELECT p, k, sum(k) OVER w, count(*) OVER w, group_concat(k,',') OVER w, first_value(k) OVER w, last_value(k) OVER w FROM t WINDOW w AS (PARTITION BY p ORDER BY k DESC NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW ) ORDER BY p, k DESC NULLS LAST;
}
expect unordered {
    1|4|4|1|4|4|4
    1|4|8|2|4,4|4|4
    1|3|11|3|4,4,3|4|3
    1|1|12|4|4,4,3,1|4|1
    1|1|13|5|4,4,3,1,1|4|1
    1||13|6|4,4,3,1,1|4|
    2|7|7|1|7|7|7
}

@setup anchored_shapes
test anchored-window-desc-m0-s0-e0-n1-x1 {
    SELECT p, k, sum(k) OVER w, count(*) OVER w, group_concat(k,',') OVER w, first_value(k) OVER w, last_value(k) OVER w FROM t WINDOW w AS (PARTITION BY p ORDER BY k DESC NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES) ORDER BY p, k DESC NULLS LAST;
}
expect unordered {
    1|4|4|1|4|4|4
    1|4|4|1|4|4|4
    1|3|11|3|4,4,3|4|3
    1|1|12|4|4,4,3,1|4|1
    1|1|12|4|4,4,3,1|4|1
    1||13|6|4,4,3,1,1|4|
    2|7|7|1|7|7|7
}

