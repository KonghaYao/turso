@setup nested_json_values
test anchored-original-nested-json-m2-f0-x1-v0 {
    SELECT id,
           json_group_array(json(j)) OVER w,
           json_group_object(id, json(j)) OVER w,
           json(jsonb_group_array(json(j)) OVER w),
           json(jsonb_group_object(id, json(j)) OVER w)
    FROM tj
    WINDOW w AS (ORDER BY k RANGE BETWEEN 1 PRECEDING AND CURRENT ROW EXCLUDE CURRENT ROW)
    ORDER BY id;
}
expect {
    1|[[2,"x,y"]]|{"2":[2,"x,y"]}|[[2,"x,y"]]|{"2":[2,"x,y"]}
    2|[{"a":1}]|{"1":{"a":1}}|[{"a":1}]|{"1":{"a":1}}
    3|[{"z":[3,4]}]|{"4":{"z":[3,4]}}|[{"z":[3,4]}]|{"4":{"z":[3,4]}}
    4|["p,q"]|{"3":"p,q"}|["p,q"]|{"3":"p,q"}
    5|[]|{}|[]|{}
}

