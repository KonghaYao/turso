    ORDER BY id;
}
expect {
    1|["plain"]|{"2":"plain"}|["plain"]|{"2":"plain"}
    2|[{"a":1}]|{"1":{"a":1}}|[{"a":1}]|{"1":{"a":1}}
    3|["plain"]|{"4":"plain"}|["plain"]|{"4":"plain"}
    4|["p,q"]|{"3":"p,q"}|["p,q"]|{"3":"p,q"}
    5|[]|{}|[]|{}
}

