           json_group_array(json(j)) OVER w,
           json_group_object(id, json(j)) OVER w,
           json(jsonb_group_array(json(j)) OVER w),
           json(jsonb_group_object(id, json(j)) OVER w)
    FROM tj
    WINDOW w AS (ORDER BY k GROUPS BETWEEN 2 FOLLOWING AND 2 FOLLOWING EXCLUDE CURRENT ROW)
    ORDER BY id;
}
expect {
    1|[null]|{"5":null}|[null]|{"5":null}
    2|[null]|{"5":null}|[null]|{"5":null}
