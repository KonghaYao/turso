@database :memory:

# Original setup copied verbatim; all 12 join/filter substitutions below.
setup or_join_rows {
    CREATE TABLE or_left(id INTEGER PRIMARY KEY, x INTEGER, flag INTEGER);
    CREATE INDEX or_left_x ON or_left(x);
    INSERT INTO or_left VALUES
        (1, 1, 1), (2, 1, 0), (3, 2, 1), (4, 2, 0), (5, NULL, 1), (6, 3, 1);

    CREATE TABLE or_right(id INTEGER PRIMARY KEY, left_id INTEGER, y INTEGER);
    CREATE INDEX or_right_y ON or_right(y);
    INSERT INTO or_right VALUES
        (1, 1, 2), (2, 1, 1), (3, 2, 2), (4, 3, 1),
        (5, 3, 2), (6, 4, 1), (7, 5, NULL), (8, 999, 1);
}

@setup or_join_rows
test fixed-original-or-join-join-filter-1 {
    SELECT l.id, r.id, l.x, r.y
    FROM or_left AS l JOIN or_right AS r ON l.id = r.left_id
    WHERE (l.x = 1 AND r.y = 2) OR (l.x = 2 AND r.y = 1)
    ORDER BY l.id, r.id;
}
expect {
    1|1|1|2
    2|3|1|2
    3|4|2|1
    4|6|2|1
}

@setup or_join_rows
test fixed-original-or-join-join-filter-2 {
    SELECT l.id, r.id, l.x, r.y
    FROM or_left AS l JOIN or_right AS r ON l.id = r.left_id
    WHERE (1 = l.x AND 2 = r.y) OR (2 = l.x AND 1 = r.y)
    ORDER BY l.id, r.id;
}
expect {
    1|1|1|2
    2|3|1|2
    3|4|2|1
    4|6|2|1
}

@setup or_join_rows
test fixed-original-or-join-join-filter-3 {
    SELECT l.id, r.id, l.x, r.y
    FROM or_left AS l JOIN or_right AS r ON l.id = r.left_id
    WHERE (l.x = 1 AND r.y = 2) OR r.y = 1
    ORDER BY l.id, r.id;
}
expect {
    1|1|1|2
    1|2|1|1
    2|3|1|2
    3|4|2|1
    4|6|2|1
}

@setup or_join_rows
test fixed-original-or-join-join-filter-4 {
    SELECT l.id, r.id, l.x, r.y
    FROM or_left AS l JOIN or_right AS r ON l.id = r.left_id
    WHERE (l.x = 1 AND (r.y = 2 AND l.flag = 1)) OR (l.x = 2 AND (r.y = 1 AND l.flag = 1))
    ORDER BY l.id, r.id;
}
expect {
    1|1|1|2
    3|4|2|1
}

