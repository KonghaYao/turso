    FROM matrix_left AS l
    JOIN matrix_right AS r ON r.k = l.k
    WHERE (l.id <= 8 OR l.id IS NULL) AND (coalesce(l.flag, -1) <> coalesce(r.flag, -1))
    ORDER BY l.id, r.id ;
}
expect {
    1|10|1|1|1|1|l1|r10
    2|11|1.0|1.0|2|2||
    3|12|1|1|1|2|l3|r12
    5|14|2|2|||l5|
    6|14|2|2|2||l6|
    6|15|2|2|2|2|l6|r15
    6|16|2|2|2|2|l6|r16
    8|18|1|1|1|1|l8|r18
}

