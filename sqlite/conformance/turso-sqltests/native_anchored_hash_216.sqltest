    3||1||1||l3|
    4||||1||l4|
    5||2||||l5|
    7||x||1|||
}

@setup anchored_hash_rows
test anchored-j2-c3-f4-p2 {
    SELECT l.id, r.id, l.k, r.k, l.k2, r.k2, l.payload, r.payload
    FROM matrix_left AS l
    FULL OUTER JOIN matrix_right AS r ON r.k2 = l.k2 AND r.k = l.k
    WHERE (l.id <= 8 OR l.id IS NULL) AND (r.payload IS NULL)
    ORDER BY l.id, r.id LIMIT 5 OFFSET 3;
}
expect {
    4||||1||l4|
    5||2||||l5|
    7||x||1|||
}

@setup anchored_hash_rows
test anchored-j2-c3-f5-p0 {
    SELECT l.id, r.id, l.k, r.k, l.k2, r.k2, l.payload, r.payload
    FROM matrix_left AS l
    FULL OUTER JOIN matrix_right AS r ON r.k2 = l.k2 AND r.k = l.k
    WHERE (l.id <= 8 OR l.id IS NULL) AND (coalesce(l.flag, -1) <> coalesce(r.flag, -1))
    ORDER BY l.id, r.id ;
}
expect {
    |12||1||2||r12
    |13||||1||r13
    |14||2||||
    1|10|1|1|1|1|l1|r10
    2|11|1.0|1.0|2|2||
    3||1||1||l3|
    4||||1||l4|
    5||2||||l5|
    6|15|2|2|2|2|l6|r15
    6|16|2|2|2|2|l6|r16
    7||x||1|||
    8|18|1|1|1|1|l8|r18
}

@setup anchored_hash_rows
test anchored-j2-c3-f5-p1 {
    SELECT l.id, r.id, l.k, r.k, l.k2, r.k2, l.payload, r.payload
    FROM matrix_left AS l
    FULL OUTER JOIN matrix_right AS r ON r.k2 = l.k2 AND r.k = l.k
    WHERE (l.id <= 8 OR l.id IS NULL) AND (coalesce(l.flag, -1) <> coalesce(r.flag, -1))
