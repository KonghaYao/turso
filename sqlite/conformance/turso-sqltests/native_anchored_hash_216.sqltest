@database :memory:

# Generated from frozen join/hash.sqltest typed INSERT rows;
# fixed expectations come solely from independent Python enumeration.
setup anchored_hash_rows {
    CREATE TABLE matrix_left(id INTEGER PRIMARY KEY, k, k2, flag, payload);
    CREATE TABLE matrix_right(id INTEGER PRIMARY KEY, k, k2, flag, payload);
    INSERT INTO matrix_left VALUES
        (1, 1, 1, 1, 'l1'),
        (2, 1.0, 2, 0, NULL),
        (3, '1', 1, 1, 'l3'),
        (4, NULL, 1, 0, 'l4'),
        (5, 2, NULL, 1, 'l5'),
        (6, 2, 2, NULL, 'l6'),
        (7, 'x', 1, 1, NULL),
        (8, X'31', 1, 0, 'l8');
    INSERT INTO matrix_right VALUES
        (10, 1, 1, 0, 'r10'),
        (11, 1.0, 2, 1, NULL),
        (12, '1', 2, 0, 'r12'),
        (13, NULL, 1, 1, 'r13'),
        (14, 2, NULL, 0, NULL),
        (15, 2, 2, 1, 'r15'),
        (16, 2, 2, 1, 'r16'),
        (17, 'y', 1, NULL, 'r17'),
        (18, X'31', 1, 1, 'r18');
    -- These estimates make Turso choose a hash join while the test data stays small.
    ANALYZE;
    DELETE FROM sqlite_stat1;
    INSERT INTO sqlite_stat1(tbl, idx, stat) VALUES
        ('matrix_left', NULL, '1000'),
        ('matrix_right', NULL, '100000');
    ANALYZE sqlite_schema;
}

@setup anchored_hash_rows
test anchored-j0-c0-f0-p0 {
    SELECT l.id, r.id, l.k, r.k, l.k2, r.k2, l.payload, r.payload
    FROM matrix_left AS l
    JOIN matrix_right AS r ON l.k = r.k
    WHERE (l.id <= 8 OR l.id IS NULL) AND (1)
    ORDER BY l.id, r.id ;
}
expect {
    1|10|1|1|1|1|l1|r10
    1|11|1|1.0|1|2|l1|
    2|10|1.0|1|2|1||r10
    2|11|1.0|1.0|2|2||
    3|12|1|1|1|2|l3|r12
    5|14|2|2|||l5|
    5|15|2|2||2|l5|r15
    5|16|2|2||2|l5|r16
    6|14|2|2|2||l6|
    6|15|2|2|2|2|l6|r15
    6|16|2|2|2|2|l6|r16
    8|18|1|1|1|1|l8|r18
}

@setup anchored_hash_rows
test anchored-j0-c0-f0-p1 {
    SELECT l.id, r.id, l.k, r.k, l.k2, r.k2, l.payload, r.payload
    FROM matrix_left AS l
    JOIN matrix_right AS r ON l.k = r.k
    WHERE (l.id <= 8 OR l.id IS NULL) AND (1)
    ORDER BY l.id, r.id LIMIT 7;
}
expect {
    1|10|1|1|1|1|l1|r10
    1|11|1|1.0|1|2|l1|
    2|10|1.0|1|2|1||r10
    2|11|1.0|1.0|2|2||
    3|12|1|1|1|2|l3|r12
    5|14|2|2|||l5|
    5|15|2|2||2|l5|r15
}

@setup anchored_hash_rows
test anchored-j0-c0-f0-p2 {
    SELECT l.id, r.id, l.k, r.k, l.k2, r.k2, l.payload, r.payload
    FROM matrix_left AS l
    JOIN matrix_right AS r ON l.k = r.k
    WHERE (l.id <= 8 OR l.id IS NULL) AND (1)
    ORDER BY l.id, r.id LIMIT 5 OFFSET 3;
}
expect {
    2|11|1.0|1.0|2|2||
    3|12|1|1|1|2|l3|r12
    5|14|2|2|||l5|
    5|15|2|2||2|l5|r15
    5|16|2|2||2|l5|r16
}

