@database :memory:

setup sample {
    CREATE TABLE inner_t(k INTEGER, v INTEGER);
    INSERT INTO inner_t VALUES (1,10),(1,20),(2,40);
    CREATE TABLE outer_t(k INTEGER PRIMARY KEY);
    INSERT INTO outer_t VALUES (1),(2),(3);
}

@setup sample
test scalar-constant-aggregate-limit-zero {
    SELECT 9,(SELECT count(*) FROM inner_t LIMIT 0);
}
expect {
    9|
}

@setup sample
test scalar-constant-empty-count-limit-one {
    SELECT 9,(SELECT count(*) FROM inner_t WHERE k=9 LIMIT 1);
}
expect {
    9|0
}

@setup sample
test scalar-constant-count-limit-one {
    SELECT 9,(SELECT count(*) FROM inner_t LIMIT 1);
}
expect {
    9|3
}

@setup sample
test correlated-count-limit-zero {
    SELECT o.k,(SELECT count(*) FROM inner_t i WHERE i.k=o.k LIMIT 0)
      FROM outer_t o ORDER BY o.k;
}
expect {
    1|
    2|
    3|
}

@setup sample
test correlated-count-limit-one {
    SELECT o.k,(SELECT count(*) FROM inner_t i WHERE i.k=o.k LIMIT 1)
      FROM outer_t o ORDER BY o.k;
}
expect {
    1|2
    2|1
    3|0
}

@setup sample
test correlated-count-limit-offset-one {
    SELECT o.k,(SELECT count(*) FROM inner_t i WHERE i.k=o.k LIMIT 1 OFFSET 1)
      FROM outer_t o ORDER BY o.k;
}
expect {
    1|
    2|
    3|
}

@setup sample
test correlated-sum-limit-zero {
    SELECT o.k,(SELECT sum(v) FROM inner_t i WHERE i.k=o.k LIMIT 0)
      FROM outer_t o ORDER BY o.k;
}
expect {
    1|
    2|
    3|
}

@setup sample
test constant-count-order-by-limit-zero {
    SELECT 9,(SELECT count(*) FROM inner_t ORDER BY count(*) LIMIT 0);
}
expect {
    9|
}

@setup sample
test nonagg-scalar-limit-zero-control {
    SELECT 9,(SELECT v FROM inner_t ORDER BY v DESC LIMIT 0),
             (SELECT v FROM inner_t ORDER BY v DESC LIMIT 1);
}
expect {
    9||40
}

@setup sample
test scalar-count-expression-zero-limit {
    SELECT 9,(SELECT count(*) FROM inner_t LIMIT CAST(0 AS INTEGER));
}
expect {
    9|
}
