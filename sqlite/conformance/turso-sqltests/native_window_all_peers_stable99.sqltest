@database :memory:

# Verbatim all_peers setup and every exact original matrix expansion.
setup all_peers {
    CREATE TABLE tap(k INT, v INT);
    INSERT INTO tap VALUES (7,1),(7,2),(7,3),(7,4);
}

@setup all_peers
test fixed-original-all-peers-m1-s1-e1-x2 {
    SELECT v, sum(v) OVER w, count(*) OVER w
    FROM tap
    WINDOW w AS (ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES)
    ORDER BY v;
}
expect {
    1|1|1
    2|2|1
    3|3|1
    4|4|1
}

@setup all_peers
test fixed-original-all-peers-m1-s1-e1-x3 {
    SELECT v, sum(v) OVER w, count(*) OVER w
    FROM tap
    WINDOW w AS (ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE GROUP)
    ORDER BY v;
}
expect {
    1||0
    2||0
    3||0
    4||0
}

@setup all_peers
test fixed-original-all-peers-m1-s1-e2-x2 {
    SELECT v, sum(v) OVER w, count(*) OVER w
    FROM tap
    WINDOW w AS (ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND 1 FOLLOWING EXCLUDE TIES)
    ORDER BY v;
}
expect {
    1|1|1
    2|2|1
    3|3|1
    4|4|1
}

