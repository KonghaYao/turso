@database :memory:

# Verbatim original recursive row setup and exact full 48-way SQL.
setup correlated_comparison_many_rows {
    CREATE TABLE many_outer(id INTEGER PRIMARY KEY, k INTEGER, v, text_key TEXT COLLATE NOCASE);
    CREATE TABLE many_inner(k INTEGER, v, text_key TEXT COLLATE BINARY);
    WITH RECURSIVE numbers(n) AS (
        VALUES(1) UNION ALL SELECT n + 1 FROM numbers WHERE n < 45
    )
    INSERT INTO many_outer
    SELECT n,
           CASE WHEN n % 7 = 0 THEN NULL ELSE n % 5 END,
           CASE WHEN n % 9 = 0 THEN NULL
                WHEN n % 15 = 0 THEN x'0102'
                WHEN n % 13 = 0 THEN CAST(n % 17 AS REAL)
                WHEN n % 3 = 0 THEN CAST(n % 17 AS TEXT)
                ELSE n % 17 END,
           CASE WHEN n % 11 = 0 THEN NULL ELSE char(65 + n % 5) END
    FROM numbers;
    WITH RECURSIVE numbers(n) AS (
        VALUES(1) UNION ALL SELECT n + 1 FROM numbers WHERE n < 50
    )
    INSERT INTO many_inner
    SELECT CASE WHEN n % 8 = 0 THEN NULL ELSE n % 5 END,
           CASE WHEN n % 10 = 0 THEN NULL
                WHEN n % 15 = 0 THEN x'0102'
                WHEN n % 13 = 0 THEN CAST(n % 17 AS REAL)
                WHEN n % 4 = 0 THEN CAST(n % 17 AS TEXT)
                ELSE n % 17 END,
           CASE WHEN n % 12 = 0 THEN NULL ELSE char(65 + n % 5) END
    FROM numbers;
    CREATE INDEX many_inner_k_v ON many_inner(k, v);
    CREATE INDEX many_inner_v ON many_inner(v);
    ANALYZE;
}

@setup correlated_comparison_many_rows
test fixed-original-exists-manyrows-p1-c1-k1 {
    SELECT o.id
    FROM many_outer AS o
    WHERE EXISTS (
        SELECT 1 FROM many_inner AS i WHERE i.v < o.v AND i.k = o.k
    )
    ORDER BY o.id;
}
expect {
    2
    3
    4
    5
    6
    8
    10
    11
    12
    13
    15
    16
    19
    20
    22
    23
    24
    25
    26
    29
    30
    31
    32
    33
    37
    38
    39
    40
    41
    43
    44
}

