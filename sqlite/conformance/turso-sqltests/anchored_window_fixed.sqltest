@setup filtered
test fixed-filter-rows-2-preceding-1-following-none {
    SELECT k,sum(v) FILTER (WHERE k%2=0) OVER w,
           count(v) FILTER (WHERE k%2=0) OVER w FROM tf
    WINDOW w AS (ORDER BY k ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING )
    ORDER BY k;
}
expect {
    1|20|1
    2|20|1
    3|60|2
    4|60|2
    5|100|2
    6|100|2
    7|60|1
}

@setup filtered
test fixed-filter-rows-2-preceding-1-following-current-row {
    SELECT k,sum(v) FILTER (WHERE k%2=0) OVER w,
           count(v) FILTER (WHERE k%2=0) OVER w FROM tf
    WINDOW w AS (ORDER BY k ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING EXCLUDE CURRENT ROW)
    ORDER BY k;
}
expect {
    1|20|1
    2||0
    3|60|2
    4|20|1
    5|100|2
    6|40|1
    7|60|1
}

