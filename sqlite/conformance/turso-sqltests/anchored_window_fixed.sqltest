@database :memory:

# Two setup blocks copied from original frame_matrix / frame_matrix_edge templates.
setup shapes {
    CREATE TABLE t(p INT, k INT);
    INSERT INTO t VALUES (1,NULL),(1,1),(1,1),(1,3),(1,4),(1,4),(2,7);
}

setup filtered {
    CREATE TABLE tf(k INT, v INT);
    INSERT INTO tf VALUES (1,10),(2,20),(3,30),(4,40),(5,50),(6,60),(7,70);
}

@setup shapes
test fixed-shapes-groups-preceding-current-none {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW )
    ORDER BY p,k;
}
expect {
    1|||1
    1|1|2|3
    1|1|2|3
    1|3|5|3
    1|4|11|3
    1|4|11|3
    2|7|7|1
}

@setup shapes
test fixed-shapes-groups-preceding-current-current-row {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW EXCLUDE CURRENT ROW)
    ORDER BY p,k;
}
expect {
    1|||0
    1|1|1|2
    1|1|1|2
    1|3|2|2
    1|4|7|2
    1|4|7|2
    2|7||0
}

@setup shapes
test fixed-shapes-groups-preceding-current-group {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW EXCLUDE GROUP)
    ORDER BY p,k;
}
expect {
    1|||0
    1|1||1
    1|1||1
    1|3|2|2
    1|4|3|1
    1|4|3|1
    2|7||0
}

@setup shapes
test fixed-shapes-groups-preceding-current-ties {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW EXCLUDE TIES)
    ORDER BY p,k;
}
expect {
    1|||1
    1|1|1|2
    1|1|1|2
    1|3|5|3
    1|4|7|2
    1|4|7|2
    2|7|7|1
}

@setup shapes
test fixed-shapes-groups-current-following-none {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN CURRENT ROW AND 1 FOLLOWING )
    ORDER BY p,k;
}
expect {
    1||2|3
    1|1|5|3
    1|1|5|3
    1|3|11|3
    1|4|8|2
    1|4|8|2
    2|7|7|1
}

@setup shapes
test fixed-shapes-groups-current-following-current-row {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN CURRENT ROW AND 1 FOLLOWING EXCLUDE CURRENT ROW)
    ORDER BY p,k;
}
expect {
    1||2|2
    1|1|4|2
    1|1|4|2
    1|3|8|2
    1|4|4|1
    1|4|4|1
    2|7||0
}

@setup shapes
test fixed-shapes-groups-current-following-group {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN CURRENT ROW AND 1 FOLLOWING EXCLUDE GROUP)
    ORDER BY p,k;
}
expect {
    1||2|2
    1|1|3|1
    1|1|3|1
    1|3|8|2
    1|4||0
    1|4||0
    2|7||0
}

@setup shapes
test fixed-shapes-groups-current-following-ties {
    SELECT p,k,sum(k) OVER w,count(*) OVER w FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k GROUPS BETWEEN CURRENT ROW AND 1 FOLLOWING EXCLUDE TIES)
    ORDER BY p,k;
}
expect {
    1||2|3
    1|1|4|2
    1|1|4|2
    1|3|11|3
    1|4|4|1
    1|4|4|1
    2|7|7|1
}

