@database :memory:

# Original two-copies matrix expansions; independent source-row aggregation.
setup anchored_correlated_rows {
    CREATE TABLE outer_rows(
        id INTEGER PRIMARY KEY,
        key1 INTEGER,
        key2 INTEGER,
        amount INTEGER,
        text_key TEXT
    );
    CREATE TABLE inner_rows(key1 INTEGER, key2 INTEGER, amount INTEGER, text_key TEXT);
    CREATE TABLE outer_key2(id INTEGER PRIMARY KEY, key2 INTEGER);
    INSERT INTO outer_rows VALUES
        (1, 1, 10, 5, 'A'),
        (2, 1, 10, 15, 'a'),
        (3, 2, 20, 7, 'B'),
        (4, 3, 30, 9, 'C'),
        (5, NULL, 40, 4, NULL),
        (6, 2, NULL, NULL, 'b');
    INSERT INTO inner_rows VALUES
        (1, 10, 10, 'a'),
        (1, 10, 20, 'A'),
        (1, 99, 100, 'x'),
        (2, 20, 6, 'b'),
        (2, 20, NULL, 'B'),
        (2, NULL, 7, NULL),
        (NULL, 40, 99, NULL);
    INSERT INTO outer_key2 VALUES (1, 10), (3, 20), (5, 40);
}

@setup anchored_correlated_rows
test anchored-two-copies-a0 {
    SELECT o.id,
           (SELECT avg(i.amount) FROM inner_rows i WHERE i.key1 = o.key1),
           (SELECT avg(i.amount) FROM inner_rows i WHERE i.key1 = o.key1)
    FROM outer_rows o
    ORDER BY o.id;
}
expect {
    1|43.3333333333333|43.3333333333333
    2|43.3333333333333|43.3333333333333
    3|6.5|6.5
    4||
    5||
    6|6.5|6.5
}

@setup anchored_correlated_rows
test anchored-two-copies-a1 {
    SELECT o.id,
           (SELECT min(i.amount) FROM inner_rows i WHERE i.key1 = o.key1),
           (SELECT min(i.amount) FROM inner_rows i WHERE i.key1 = o.key1)
    FROM outer_rows o
    ORDER BY o.id;
}
expect {
    1|10|10
    2|10|10
    3|6|6
    4||
    5||
    6|6|6
}

@setup anchored_correlated_rows
test anchored-two-copies-a2 {
    SELECT o.id,
           (SELECT max(i.amount) FROM inner_rows i WHERE i.key1 = o.key1),
           (SELECT max(i.amount) FROM inner_rows i WHERE i.key1 = o.key1)
    FROM outer_rows o
    ORDER BY o.id;
}
expect {
    1|100|100
    2|100|100
    3|7|7
    4||
    5||
    6|7|7
}

@setup anchored_correlated_rows
test anchored-two-copies-a3 {
    SELECT o.id,
           (SELECT count(*) FROM inner_rows i WHERE i.key1 = o.key1),
           (SELECT count(*) FROM inner_rows i WHERE i.key1 = o.key1)
    FROM outer_rows o
    ORDER BY o.id;
}
expect {
    1|3|3
    2|3|3
    3|3|3
    4|0|0
    5|0|0
    6|3|3
}

@setup anchored_correlated_rows
test anchored-two-copies-a4 {
    SELECT o.id,
           (SELECT count(i.amount) FROM inner_rows i WHERE i.key1 = o.key1),
           (SELECT count(i.amount) FROM inner_rows i WHERE i.key1 = o.key1)
    FROM outer_rows o
    ORDER BY o.id;
}
expect {
    1|3|3
    2|3|3
    3|2|2
    4|0|0
    5|0|0
    6|2|2
}

@setup anchored_correlated_rows
test anchored-two-copies-a5 {
    SELECT o.id,
           (SELECT total(i.amount) FROM inner_rows i WHERE i.key1 = o.key1),
           (SELECT total(i.amount) FROM inner_rows i WHERE i.key1 = o.key1)
    FROM outer_rows o
    ORDER BY o.id;
}
expect {
    1|130.0|130.0
    2|130.0|130.0
    3|13.0|13.0
    4|0.0|0.0
    5|0.0|0.0
    6|13.0|13.0
}
