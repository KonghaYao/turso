@database :memory:

# Complete original 180-product including 15 illegal frame-bound cases.
setup anchored_filtered {
    CREATE TABLE tf(k INT, v INT);
    INSERT INTO tf VALUES (1,10),(2,20),(3,30),(4,40),(5,50),(6,60),(7,70);
}

@setup anchored_filtered
test anchored-window-filter-f0-m0-s0-e0 {
    SELECT k, sum(v) FILTER (WHERE k % 2 = 0) OVER (ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM tf ORDER BY k;
}
expect {
    1|
    2|20
    3|20
    4|60
    5|60
    6|120
    7|120
}

@setup anchored_filtered
test anchored-window-filter-f0-m0-s0-e1 {
    SELECT k, sum(v) FILTER (WHERE k % 2 = 0) OVER (ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND 2 FOLLOWING) FROM tf ORDER BY k;
}
expect {
    1|20
    2|60
    3|60
    4|120
    5|120
    6|120
    7|120
}

@setup anchored_filtered
test anchored-window-filter-f0-m0-s0-e2 {
    SELECT k, sum(v) FILTER (WHERE k % 2 = 0) OVER (ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM tf ORDER BY k;
}
expect {
    1|120
    2|120
    3|120
    4|120
    5|120
    6|120
    7|120
}

