@database :memory:

# Full 630 original frame-asc SQL expansions; unordered peers on outer ORDER BY p,k.

setup shapes {
    CREATE TABLE t(p INT, k INT);
    INSERT INTO t VALUES (1,NULL),(1,1),(1,1),(1,3),(1,4),(1,4),(2,7);
}


@setup shapes
test fixed-original-frame-asc-m0-s0-e0-x0 {
    SELECT p, k, sum(k) OVER w, count(*) OVER w, min(k) OVER w, max(k) OVER w,
           group_concat(k,',') OVER w, first_value(k) OVER w, last_value(k) OVER w,
           nth_value(k,2) OVER w
    FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND 2 PRECEDING )
    ORDER BY p, k;
}
expect unordered {
    1|||0||||||
    1|1||0||||||
    1|1||1||||||
    1|3|1|2|1|1|1||1|1
    1|4|2|3|1|1|1,1||1|1
    1|4|5|4|1|3|1,1,3||3|1
    2|7||0||||||
}

@setup shapes
test fixed-original-frame-asc-m0-s0-e0-x1 {
    SELECT p, k, sum(k) OVER w, count(*) OVER w, min(k) OVER w, max(k) OVER w,
           group_concat(k,',') OVER w, first_value(k) OVER w, last_value(k) OVER w,
           nth_value(k,2) OVER w
    FROM t
    WINDOW w AS (PARTITION BY p ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND 2 PRECEDING EXCLUDE NO OTHERS)
    ORDER BY p, k;
}
expect unordered {
    1|||0||||||
    1|1||0||||||
    1|1||1||||||
    1|3|1|2|1|1|1||1|1
    1|4|2|3|1|1|1,1||1|1
    1|4|5|4|1|3|1,1,3||3|1
    2|7||0||||||
}

