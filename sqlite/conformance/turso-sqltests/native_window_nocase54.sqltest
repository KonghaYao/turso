@database :memory:

# Full original NOCASE collated key SQL, unordered peer output sequence.
setup nocase_keys {
    CREATE TABLE tcl(k TEXT);
    INSERT INTO tcl VALUES ('a'),('A'),('b'),('B'),('B'),('c');
}


@setup nocase_keys
test fixed-original-nocase-m0-s0-e0-x0 {
    SELECT lower(k), count(*) OVER w, min(lower(k)) OVER w, group_concat(lower(k), ',') OVER w
    FROM tcl
    WINDOW w AS (ORDER BY k COLLATE NOCASE ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW )
    ORDER BY k COLLATE NOCASE;
}
expect unordered {
    a|1|a|a
    a|2|a|a,a
    b|3|a|a,a,b
    b|4|a|a,a,b,b
    b|5|a|a,a,b,b,b
    c|6|a|a,a,b,b,b,c
}

@setup nocase_keys
test fixed-original-nocase-m0-s0-e0-x1 {
    SELECT lower(k), count(*) OVER w, min(lower(k)) OVER w, group_concat(lower(k), ',') OVER w
    FROM tcl
    WINDOW w AS (ORDER BY k COLLATE NOCASE ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE GROUP)
    ORDER BY k COLLATE NOCASE;
}
expect unordered {
    a|0||
    a|0||
    b|2|a|a,a
    b|2|a|a,a
    b|2|a|a,a
    c|5|a|a,a,b,b,b
}

@setup nocase_keys
test fixed-original-nocase-m0-s0-e1-x0 {
    SELECT lower(k), count(*) OVER w, min(lower(k)) OVER w, group_concat(lower(k), ',') OVER w
    FROM tcl
    WINDOW w AS (ORDER BY k COLLATE NOCASE ROWS BETWEEN UNBOUNDED PRECEDING AND 1 FOLLOWING )
    ORDER BY k COLLATE NOCASE;
}
expect unordered {
    a|2|a|a,a
    a|3|a|a,a,b
    b|4|a|a,a,b,b
    b|5|a|a,a,b,b,b
    b|6|a|a,a,b,b,b,c
    c|6|a|a,a,b,b,b,c
}

@setup nocase_keys
test fixed-original-nocase-m0-s0-e1-x1 {
    SELECT lower(k), count(*) OVER w, min(lower(k)) OVER w, group_concat(lower(k), ',') OVER w
    FROM tcl
    WINDOW w AS (ORDER BY k COLLATE NOCASE ROWS BETWEEN UNBOUNDED PRECEDING AND 1 FOLLOWING EXCLUDE GROUP)
    ORDER BY k COLLATE NOCASE;
}
expect unordered {
    a|0||
    a|1|b|b
    b|2|a|a,a
    b|2|a|a,a
    b|3|a|a,a,c
    c|5|a|a,a,b,b,b
}

@setup nocase_keys
test fixed-original-nocase-m0-s0-e2-x0 {
    SELECT lower(k), count(*) OVER w, min(lower(k)) OVER w, group_concat(lower(k), ',') OVER w
    FROM tcl
    WINDOW w AS (ORDER BY k COLLATE NOCASE ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING )
    ORDER BY k COLLATE NOCASE;
}
expect unordered {
    a|6|a|a,a,b,b,b,c
    a|6|a|a,a,b,b,b,c
    b|6|a|a,a,b,b,b,c
    b|6|a|a,a,b,b,b,c
    b|6|a|a,a,b,b,b,c
    c|6|a|a,a,b,b,b,c
}

@setup nocase_keys
test fixed-original-nocase-m0-s0-e2-x1 {
    SELECT lower(k), count(*) OVER w, min(lower(k)) OVER w, group_concat(lower(k), ',') OVER w
    FROM tcl
    WINDOW w AS (ORDER BY k COLLATE NOCASE ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP)
