}

@setup anchored_offset_expressions
test anchored-window-rejected-ending-m0-o2 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN CURRENT ROW AND CAST(CURRENT_TIMESTAMP AS INTEGER) FOLLOWING ) FROM toe ORDER BY k;
}
