@database :memory:

# Two original 12-case error matrices with source-derived specific messages.
setup anchored_offset_expressions {
    CREATE TABLE toe(k INT);
    INSERT INTO toe VALUES (1),(2),(3);
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m0-o0 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN abs(-1) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m0-o1 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN coalesce(NULL, 1) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m0-o2 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN CAST(CURRENT_DATE AS INTEGER) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m0-o3 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN CASE WHEN 1 THEN 1 ELSE abs(-1) END PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m1-o0 {
    SELECT k, sum(k) OVER ( ORDER BY k GROUPS BETWEEN abs(-1) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m1-o1 {
    SELECT k, sum(k) OVER ( ORDER BY k GROUPS BETWEEN coalesce(NULL, 1) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m1-o2 {
    SELECT k, sum(k) OVER ( ORDER BY k GROUPS BETWEEN CAST(CURRENT_DATE AS INTEGER) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m1-o3 {
    SELECT k, sum(k) OVER ( ORDER BY k GROUPS BETWEEN CASE WHEN 1 THEN 1 ELSE abs(-1) END PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m2-o0 {
    SELECT k, sum(k) OVER ( ORDER BY k RANGE BETWEEN abs(-1) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative number
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m2-o1 {
    SELECT k, sum(k) OVER ( ORDER BY k RANGE BETWEEN coalesce(NULL, 1) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative number
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m2-o2 {
    SELECT k, sum(k) OVER ( ORDER BY k RANGE BETWEEN CAST(CURRENT_DATE AS INTEGER) PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative number
}

@setup anchored_offset_expressions
test anchored-window-rejected-starting-m2-o3 {
    SELECT k, sum(k) OVER ( ORDER BY k RANGE BETWEEN CASE WHEN 1 THEN 1 ELSE abs(-1) END PRECEDING AND CURRENT ROW ) FROM toe ORDER BY k;
}
expect error {
    frame starting offset must be a non-negative number
}

@setup anchored_offset_expressions
test anchored-window-rejected-ending-m0-o0 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN CURRENT ROW AND abs(-1) FOLLOWING ) FROM toe ORDER BY k;
}
expect error {
    frame ending offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-ending-m0-o1 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN CURRENT ROW AND coalesce(NULL, 1) FOLLOWING ) FROM toe ORDER BY k;
