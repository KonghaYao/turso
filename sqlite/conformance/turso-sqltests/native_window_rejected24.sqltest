    frame ending offset must be a non-negative integer
}

@setup anchored_offset_expressions
test anchored-window-rejected-ending-m0-o3 {
    SELECT k, sum(k) OVER ( ORDER BY k ROWS BETWEEN CURRENT ROW AND CASE WHEN 0 THEN abs(-1) ELSE 1 END FOLLOWING ) FROM toe ORDER BY k;
}
