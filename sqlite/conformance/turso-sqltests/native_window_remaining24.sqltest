@database :memory:

# Original 24-way built-in coercion matrix, fixed source-only expected values.
setup anchored_small {
    CREATE TABLE ts(k INT);
    INSERT INTO ts VALUES (1),(2),(3),(4),(5);
}

@setup anchored_small
test anchored-window-remaining-b0-m0-x0 {
    SELECT k, lead(k) OVER w, count(*) OVER w FROM ts WINDOW w AS (ORDER BY k ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING ) ORDER BY k;
}
expect {
    1|2|2
    2|3|3
    3|4|3
    4|5|3
    5||2
}

@setup anchored_small
test anchored-window-remaining-b0-m0-x1 {
    SELECT k, lead(k) OVER w, count(*) OVER w FROM ts WINDOW w AS (ORDER BY k ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING EXCLUDE TIES) ORDER BY k;
}
expect {
    1|2|2
    2|3|3
    3|4|3
    4|5|3
    5||2
}

@setup anchored_small
test anchored-window-remaining-b0-m1-x0 {
    SELECT k, lead(k) OVER w, count(*) OVER w FROM ts WINDOW w AS (ORDER BY k GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING ) ORDER BY k;
}
expect {
    1|2|2
    2|3|3
    3|4|3
    4|5|3
    5||2
}

