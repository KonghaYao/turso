@setup anchored_small
test anchored-window-remaining-b2-m0-x0 {
    SELECT k, percent_rank() OVER w, count(*) OVER w FROM ts WINDOW w AS (ORDER BY k ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING ) ORDER BY k;
}
expect {
    1|0.0|2
    2|0.25|3
    3|0.5|3
    4|0.75|3
    5|1.0|2
}

