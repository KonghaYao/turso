    SELECT a, b, max(c) OVER w AS wv
    FROM tmc
    WINDOW w AS (ORDER BY a, b RANGE BETWEEN CURRENT ROW AND CURRENT ROW)
    ORDER BY wv, a, b;
}
expect {
    BB|y|1
    BB|y|1
    AA|y|3
    AA|x|5
    AA|x|5
    CC|x|7
    BB|x|9
}

@setup two_col_key
test fixed-original-multicol-f4-m3-s3-e3 {
    SELECT a, b, max(c) OVER w AS wv
    FROM tmc
    WINDOW w AS (ORDER BY a, b RANGE BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING)
    ORDER BY wv, a, b;
}
expect {
    BB|y|7
    BB|y|7
    CC|x|7
    AA|x|9
    AA|x|9
    AA|y|9
    BB|x|9
}
