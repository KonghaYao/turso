@database :memory:

# Original setup and all 108 original matrix SQL statements.
setup two_col_key {
    CREATE TABLE tmc(a TEXT, b TEXT, c INT);
    INSERT INTO tmc VALUES
        ('AA','x',5),('AA','x',5),('AA','y',3),
        ('BB','x',9),('BB','y',1),('BB','y',1),('CC','x',7);
}

@setup two_col_key
test fixed-original-multicol-f1-m1-s1-e1 {
    SELECT a, b, sum(c) OVER w AS wv
    FROM tmc
    WINDOW w AS (ORDER BY a, b ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING)
    ORDER BY wv, a, b;
}
expect {
    AA|x|
    AA|x|5
    AA|y|10
    BB|x|13
    BB|y|22
    BB|y|23
    CC|x|24
}

@setup two_col_key
test fixed-original-multicol-f1-m1-s1-e2 {
    SELECT a, b, sum(c) OVER w AS wv
    FROM tmc
    WINDOW w AS (ORDER BY a, b ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
    ORDER BY wv, a, b;
}
expect {
    AA|x|5
    AA|x|10
    AA|y|13
    BB|x|22
    BB|y|23
    BB|y|24
    CC|x|31
}

@setup two_col_key
test fixed-original-multicol-f1-m1-s1-e3 {
    SELECT a, b, sum(c) OVER w AS wv
    FROM tmc
    WINDOW w AS (ORDER BY a, b ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
    ORDER BY wv, a, b;
}
expect {
    AA|x|31
    AA|x|31
    AA|y|31
    BB|x|31
    BB|y|31
    BB|y|31
    CC|x|31
}

@setup two_col_key
test fixed-original-multicol-f1-m1-s2-e1 {
