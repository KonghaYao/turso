@database :memory:

# Original 18-way RANGE matrix with independently calculated fixed floating-point results.
setup anchored_reals {
    CREATE TABLE tr(k REAL);
    INSERT INTO tr VALUES (0.5),(1.0),(1.5),(3.25),(4.0),(100.0);
}

@setup anchored_reals
test anchored-window-real-s0-e0-d0 {
    SELECT k, count(*) OVER w, sum(k) OVER w FROM tr WINDOW w AS (ORDER BY k ASC RANGE BETWEEN 0.5 PRECEDING AND 0.5 FOLLOWING) ORDER BY k ASC;
}
expect {
    0.5|2|1.5
    1.0|3|3.0
    1.5|2|2.5
    3.25|1|3.25
    4.0|1|4.0
    100.0|1|100.0
}

@setup anchored_reals
test anchored-window-real-s0-e0-d1 {
    SELECT k, count(*) OVER w, sum(k) OVER w FROM tr WINDOW w AS (ORDER BY k DESC RANGE BETWEEN 0.5 PRECEDING AND 0.5 FOLLOWING) ORDER BY k DESC;
}
expect {
    100.0|1|100.0
    4.0|1|4.0
    3.25|1|3.25
    1.5|2|2.5
    1.0|3|3.0
    0.5|2|1.5
}

@setup anchored_reals
test anchored-window-real-s0-e1-d0 {
    SELECT k, count(*) OVER w, sum(k) OVER w FROM tr WINDOW w AS (ORDER BY k ASC RANGE BETWEEN 0.5 PRECEDING AND 1.5 FOLLOWING) ORDER BY k ASC;
}
expect {
    0.5|3|3.0
    1.0|3|3.0
    1.5|2|2.5
    3.25|2|7.25
    4.0|1|4.0
    100.0|1|100.0
}

@setup anchored_reals
test anchored-window-real-s0-e1-d1 {
    SELECT k, count(*) OVER w, sum(k) OVER w FROM tr WINDOW w AS (ORDER BY k DESC RANGE BETWEEN 0.5 PRECEDING AND 1.5 FOLLOWING) ORDER BY k DESC;
}
expect {
    100.0|1|100.0
    4.0|2|7.25
    3.25|1|3.25
    1.5|3|3.0
    1.0|3|3.0
    0.5|2|1.5
}

@setup anchored_reals
test anchored-window-real-s0-e2-d0 {
    SELECT k, count(*) OVER w, sum(k) OVER w FROM tr WINDOW w AS (ORDER BY k ASC RANGE BETWEEN 0.5 PRECEDING AND 2.75 FOLLOWING) ORDER BY k ASC;
}
expect {
    0.5|4|6.25
    1.0|4|6.25
    1.5|4|9.75
    3.25|2|7.25
    4.0|1|4.0
    100.0|1|100.0
}

@setup anchored_reals
test anchored-window-real-s0-e2-d1 {
    SELECT k, count(*) OVER w, sum(k) OVER w FROM tr WINDOW w AS (ORDER BY k DESC RANGE BETWEEN 0.5 PRECEDING AND 2.75 FOLLOWING) ORDER BY k DESC;
}
expect {
    100.0|1|100.0
    4.0|3|8.75
    3.25|4|6.25
    1.5|3|3.0
    1.0|3|3.0
    0.5|2|1.5
}

