@setup correlated_rows
test fixed-original-scalar-tail-1-0-0 {
    SELECT o.id, (SELECT sum(i.amount) FROM inner_rows i WHERE i.key1 < o.key1 )
    FROM outer_rows o ORDER BY o.id;
}
expect {
    1|
    2|
    3|130
    4|143
    5|
    6|130
}

