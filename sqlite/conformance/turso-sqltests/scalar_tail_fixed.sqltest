}

@setup correlated_rows
test fixed-original-scalar-tail-0-2-0 {
    SELECT o.id, (SELECT avg(i.amount) FROM inner_rows i WHERE i.key1 = o.key1 OR i.key2 = o.key2 )
    FROM outer_rows o ORDER BY o.id;
}
expect {
    1|43.3333333333333
    2|43.3333333333333
    3|6.5
    4|
    5|99.0
    6|6.5
}

