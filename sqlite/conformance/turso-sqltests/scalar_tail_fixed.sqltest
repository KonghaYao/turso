@setup correlated_rows
test fixed-original-scalar-tail-0-3-0 {
    SELECT o.id, (SELECT avg(i.amount) FROM inner_rows i WHERE i.key1 = o.key1 AND o.amount > 10 )
    FROM outer_rows o ORDER BY o.id;
}
expect {
    1|
    2|43.3333333333333
    3|
    4|
    5|
    6|
}

