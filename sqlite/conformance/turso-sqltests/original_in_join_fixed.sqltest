}
expect {
}

@setup correlated_rows
test fixed-original-in-outer-left-3 {
    SELECT o.id, k.id
    FROM outer_rows AS o LEFT JOIN outer_key2 AS k ON o.id = k.id
    WHERE k.key2 IN (
        SELECT i.amount FROM inner_rows AS i WHERE i.amount IS NOT k.key2
    )
    ORDER BY o.id, k.id;
}
expect {
}

