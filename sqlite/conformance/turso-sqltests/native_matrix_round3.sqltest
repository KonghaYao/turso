@database :memory:

# Fixed native-only results from two previously unexpanded matrix sources.
setup or_rows {
    CREATE TABLE ol(id INTEGER PRIMARY KEY,x INTEGER,flag INTEGER);
    CREATE TABLE oright(id INTEGER PRIMARY KEY,left_id INTEGER,y INTEGER);
    CREATE INDEX ol_x ON ol(x);
    CREATE INDEX oright_y ON oright(y);
    INSERT INTO ol VALUES (1,1,1),(2,1,0),(3,2,1),(4,2,0),(5,NULL,1),(6,3,1);
    INSERT INTO oright VALUES (1,1,2),(2,1,1),(3,2,2),(4,3,1),
      (5,3,2),(6,4,1),(7,5,NULL),(8,999,1);
}

# multi_index_or_compound: reversed equality operands in two AND/OR arms.
@setup or_rows
test fixed-or-reversed-equality-inner {
    SELECT l.id,r.id,l.x,r.y FROM ol AS l JOIN oright AS r ON l.id=r.left_id
    WHERE (1=l.x AND 2=r.y) OR (2=l.x AND 1=r.y)
    ORDER BY l.id,r.id;
}
expect {
    1|1|1|2
    2|3|1|2
    3|4|2|1
    4|6|2|1
}

# multi_index_or_compound: residual flag and null-extended LEFT rows.
@setup or_rows
test fixed-or-left-with-flag-residual {
    SELECT l.id,r.id,l.x,r.y FROM ol AS l LEFT JOIN oright AS r ON l.id=r.left_id
    WHERE (l.x=1 AND r.y=2 AND l.flag=1)
       OR (l.x=2 AND r.y=1 AND l.flag=1)
    ORDER BY l.id,r.id;
}
expect {
    1|1|1|2
    3|4|2|1
}

# multi_index_or_compound: right-only row survives FULL and r.y=1 OR arm.
@setup or_rows
test fixed-or-full-keeps-right-only-row {
    SELECT l.id,r.id,l.x,r.y FROM ol AS l FULL OUTER JOIN oright AS r ON l.id=r.left_id
    WHERE (l.x=1 AND r.y=2) OR r.y=1
    ORDER BY l.id,r.id;
}
expect {
    |8||1
    1|1|1|2
    1|2|1|1
    2|3|1|2
    3|4|2|1
    4|6|2|1
}

setup build_rows {
    CREATE TABLE covering_orders(id INTEGER PRIMARY KEY,customer_id INTEGER,order_date TEXT);
    CREATE INDEX covering_key ON covering_orders(customer_id,order_date);
    CREATE TABLE expression_covering_orders(id INTEGER PRIMARY KEY,customer_id INTEGER,order_date TEXT);
    CREATE INDEX expression_covering_key ON expression_covering_orders(customer_id,lower(order_date),order_date);
    CREATE TABLE partial_orders(id INTEGER PRIMARY KEY,customer_id INTEGER,order_date TEXT);
    CREATE INDEX partial_key ON partial_orders(customer_id,order_date) WHERE customer_id=100;
    CREATE TABLE inventory(product_id INTEGER,quantity INTEGER);
    INSERT INTO covering_orders VALUES (1,100,'ABC'),(2,100,'DeF'),(3,100,NULL),
      (4,200,'GHI'),(6,100,'xyz');
    INSERT INTO expression_covering_orders SELECT * FROM covering_orders;
    INSERT INTO partial_orders SELECT * FROM covering_orders;
    INSERT INTO inventory VALUES (1,2),(1,3),(2,4),(3,5),(5,6);
}

# join/memory indexed-hash-build: covering build and FULL unmatched inventory.
@setup build_rows
test fixed-covering-build-full-result {
    SELECT orders.id,orders.order_date,inventory.quantity
    FROM covering_orders AS orders FULL OUTER JOIN inventory
      ON orders.id=inventory.product_id
    WHERE orders.customer_id=100 OR orders.id IS NULL
    ORDER BY orders.id,inventory.quantity;
}
expect {
    ||6
    1|ABC|2
    1|ABC|3
    2|DeF|4
    3||5
    6|xyz|
}

# join/memory indexed-hash-build: expression+covering index, LOWER, LEFT.
@setup build_rows
test fixed-expression-covering-left-lower {
    SELECT orders.id,lower(orders.order_date),inventory.quantity
    FROM expression_covering_orders AS orders LEFT JOIN inventory
      ON orders.id=inventory.product_id
    WHERE orders.customer_id=100 OR orders.id IS NULL
    ORDER BY orders.id,inventory.quantity;
}
expect {
    1|abc|2
    1|abc|3
    2|def|4
    3||5
    6|xyz|
}

# join/memory indexed-hash-build: partial index changes access, not outer rows.
@setup build_rows
test fixed-partial-build-full-result {
    SELECT orders.id,lower(orders.order_date),inventory.quantity
    FROM partial_orders AS orders FULL OUTER JOIN inventory
      ON orders.id=inventory.product_id
    WHERE orders.customer_id=100 OR orders.id IS NULL
    ORDER BY orders.id,inventory.quantity;
}
expect {
    ||6
    1|abc|2
    1|abc|3
    2|def|4
    3||5
    6|xyz|
}

setup prefix_rows {
    CREATE TABLE parent(id INTEGER PRIMARY KEY,selected INTEGER);
    CREATE TABLE child(group_id INTEGER,parent_id INTEGER,payload INTEGER,
      PRIMARY KEY(group_id,parent_id));
    CREATE INDEX child_positive ON child(group_id,parent_id) WHERE payload>0;
    INSERT INTO parent VALUES (1,1),(2,1),(3,1),(4,0);
    INSERT INTO child VALUES (10,1,-1),(20,1,9),(30,2,8),(40,3,-5),(50,NULL,6);
    ANALYZE;
    DELETE FROM sqlite_stat1;
    INSERT INTO sqlite_stat1(tbl,idx,stat) VALUES
      ('parent',NULL,'1000'),('child',NULL,'5000000'),
      ('child','sqlite_autoindex_child_1','5000000 5000 1'),
      ('child','child_positive','5000000 5000 1');
    ANALYZE sqlite_schema;
}

# join/memory index-prefix: inequality in the first index column with JOIN.
@setup prefix_rows
test fixed-prefix-range-inner {
    SELECT parent.id,child.group_id,child.payload
    FROM parent JOIN child ON child.parent_id=parent.id AND child.group_id>15
    WHERE parent.selected=1 ORDER BY parent.id,child.group_id,child.payload;
}
expect {
    1|20|9
    2|30|8
    3|40|-5
}

# join/memory index-prefix: equality and null-extension for LEFT.
@setup prefix_rows
test fixed-prefix-equality-left-unmatched {
    SELECT parent.id,child.group_id,child.payload
    FROM parent LEFT JOIN child ON child.parent_id=parent.id AND child.group_id=10
    WHERE parent.selected=1 ORDER BY parent.id,child.group_id,child.payload;
}
expect {
    1|10|-1
    2||
    3||
}
