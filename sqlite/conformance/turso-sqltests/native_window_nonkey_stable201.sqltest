@database :memory:

# Exact original SQL for stable peer-order independent cases.
setup shapes3 {
    CREATE TABLE t3(p INT, k INT, v TEXT);
    INSERT INTO t3 VALUES (1,NULL,'q'),(1,1,'m'),(1,1,'c'),(1,3,'z'),(1,4,'a'),(2,7,'k');
}


@setup shapes3
test fixed-original-nonkey-f0-m0-s0-e0-x1 {
    SELECT p, k, min(v) OVER w AS wv
    FROM t3
    WINDOW w AS (PARTITION BY p ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES)
    ORDER BY wv, p, k;
}
expect unordered {
    1|4|a
    1|1|c
    1|3|c
    2|7|k
    1|1|m
    1||q
}

@setup shapes3
test fixed-original-nonkey-f0-m0-s0-e2-x0 {
    SELECT p, k, min(v) OVER w AS wv
    FROM t3
    WINDOW w AS (PARTITION BY p ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING )
    ORDER BY wv, p, k;
}
expect unordered {
    1||a
    1|1|a
    1|1|a
    1|3|a
    1|4|a
    2|7|k
}

@setup shapes3
test fixed-original-nonkey-f0-m0-s0-e2-x1 {
    SELECT p, k, min(v) OVER w AS wv
    FROM t3
    WINDOW w AS (PARTITION BY p ORDER BY k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES)
    ORDER BY wv, p, k;
}
expect unordered {
    1||a
    1|1|a
    1|1|a
    1|3|a
    1|4|a
    2|7|k
}

