@database :memory:

# Exact original SQL and full original source setup.
setup correlated_comparison_errors {
    CREATE TABLE error_outer(id INTEGER, wanted INTEGER, limit_value INTEGER, text_value TEXT);
    CREATE TABLE error_inner(value INTEGER, json_value TEXT);
    INSERT INTO error_outer VALUES (1, 1, 10, '1'), (2, 1, 0, 'bad JSON');
    INSERT INTO error_inner VALUES (1, '1'), (2, 'bad JSON');
}

@setup correlated_comparison_errors
test fixed-original-exists-expression-errors-p1-c1-t1 {
    SELECT o.id
    FROM error_outer AS o
    WHERE EXISTS (
        SELECT 1 FROM error_inner AS i WHERE json_extract(i.json_value, '$') < o.limit_value
    )
    ORDER BY o.id;
}
expect error {
    .*malformed JSON.*
}

@setup correlated_comparison_errors
test fixed-original-exists-expression-errors-p1-c1-t2 {
    SELECT o.id
    FROM error_outer AS o
    WHERE EXISTS (
        SELECT 1 FROM error_inner AS i WHERE json_extract(i.json_value, '$') < o.limit_value AND i.value = o.wanted
    )
    ORDER BY o.id;
}
expect error {
    .*malformed JSON.*
}

@setup correlated_comparison_errors
test fixed-original-exists-expression-errors-p1-c2-t1 {
    SELECT o.id
    FROM error_outer AS o
    WHERE EXISTS (
        SELECT 1 FROM error_inner AS i WHERE o.limit_value > json_extract(i.json_value, '$')
    )
    ORDER BY o.id;
}
expect error {
    .*malformed JSON.*
}

@setup correlated_comparison_errors
test fixed-original-exists-expression-errors-p1-c2-t2 {
