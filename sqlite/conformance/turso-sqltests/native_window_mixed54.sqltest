@database :memory:

# 54 exact original mixed-type SQL expansions; binary blob controls are literal U+0001/U+0002.
setup mixed_types {
    CREATE TABLE tm(x);
    INSERT INTO tm VALUES (NULL),(1),(2.5),(2),('t'),('T'),(x'01'),(x'0102');
}


@setup mixed_types
test fixed-original-mixed-m0-s0-e0-d0 {
    SELECT typeof(x), count(*) OVER w, min(x) OVER w, max(x) OVER w
    FROM tm
    WINDOW w AS (ORDER BY x ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
    ORDER BY x ASC;
}
expect {
    null|1||
    integer|2|1|1
    integer|3|1|2
    real|4|1|2.5
    text|5|1|T
    text|6|1|t
    blob|7|1|
    blob|8|1|
}

@setup mixed_types
test fixed-original-mixed-m0-s0-e0-d1 {
    SELECT typeof(x), count(*) OVER w, min(x) OVER w, max(x) OVER w
    FROM tm
    WINDOW w AS (ORDER BY x DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
    ORDER BY x DESC;
}
expect {
    blob|1||
    blob|2||
    text|3|t|
    text|4|T|
    real|5|2.5|
    integer|6|2|
    integer|7|1|
    null|8|1|
}

