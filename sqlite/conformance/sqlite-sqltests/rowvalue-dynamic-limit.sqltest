test offset-zero-expression-overflow-reference {
    SELECT typeof((SELECT 2 LIMIT abs(0) OFFSET abs(-9223372036854775808)));
}
expect {null}

test offset-case-shortcircuit {
    SELECT typeof((SELECT 2 LIMIT abs(0) OFFSET CASE WHEN 1 THEN NULL ELSE abs(-9223372036854775808) END));
}
expect {null}

test offset-coalesce-shortcircuit {
    SELECT typeof((SELECT 2 LIMIT abs(0) OFFSET coalesce(0,abs(-9223372036854775808))));
}
expect {null}

test offset-null-limit-rejected {
    SELECT (SELECT 2 LIMIT NULL OFFSET NULL);
}
expect error {datatype mismatch}

test offset-top-level-zero {
    SELECT count(*) FROM (SELECT 2 LIMIT abs(0) OFFSET 1.5);
}
expect {0}

test offset-top-level-nonzero-rejected {
    SELECT 2 LIMIT abs(2) OFFSET 1.5;
}
expect error {datatype mismatch}

test offset-negative-limit-rejected {
    SELECT 2 LIMIT -abs(2) OFFSET NULL;
}
expect error {datatype mismatch}

test offset-compound-zero {
    SELECT count(*) FROM (SELECT 1 UNION ALL SELECT 2 LIMIT abs(0) OFFSET NULL);
}
expect {0}

test offset-recursive-zero {
    WITH RECURSIVE numbers(value) AS (SELECT 1 UNION ALL SELECT value+1 FROM numbers WHERE value<3 LIMIT abs(0) OFFSET NULL) SELECT count(*) FROM numbers;
}
expect {0}

test offset-update-rowvalue-zero {
    CREATE TABLE pairs(left_value,right_value); INSERT INTO pairs VALUES(10,20); UPDATE pairs SET (left_value,right_value)=(SELECT 2,3 LIMIT abs(0) OFFSET 1.5); SELECT left_value IS NULL,right_value IS NULL FROM pairs;
}
expect {1|1}

test offset-update-predicate-zero {
    CREATE TABLE items(value); INSERT INTO items VALUES(1),(2); UPDATE items SET value=10 WHERE value IN (SELECT value FROM items LIMIT abs(0) OFFSET NULL); SELECT value FROM items ORDER BY value;
}
expect {1
2}

test offset-delete-predicate-zero {
    CREATE TABLE items(value); INSERT INTO items VALUES(1),(2); DELETE FROM items WHERE value IN (SELECT value FROM items LIMIT abs(0) OFFSET x'31'); SELECT value FROM items ORDER BY value;
}
expect {1
2}

