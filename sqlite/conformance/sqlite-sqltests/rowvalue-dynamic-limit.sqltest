@database :memory:

test scalar-rowvalue-dynamic-zero {
    SELECT typeof((SELECT 2 LIMIT abs(0))),coalesce((SELECT 2 LIMIT abs(0)),-1);
}
expect {null|-1}

test scalar-rowvalue-dynamic-positive-first {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(3),(1),(2);
    SELECT (SELECT value FROM items ORDER BY value LIMIT abs(2));
}
expect {1}

test scalar-rowvalue-dynamic-negative-first {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(3),(1),(2);
    SELECT (SELECT value FROM items ORDER BY value LIMIT -abs(2));
}
expect {1}

test scalar-rowvalue-dynamic-offset {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(3),(1),(2);
    SELECT (SELECT value FROM items ORDER BY value LIMIT abs(2) OFFSET abs(1));
}
expect {2}

test scalar-rowvalue-dynamic-offset-empty {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(1),(2);
    SELECT typeof((SELECT value FROM items ORDER BY value LIMIT abs(2) OFFSET abs(3)));
}
expect {null}

test scalar-rowvalue-text-zero {
    SELECT typeof((SELECT 2 LIMIT '0'));
}
expect {null}

test scalar-rowvalue-text-positive-first {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(3),(1),(2);
    SELECT (SELECT value FROM items ORDER BY value LIMIT '2');
}
expect {1}

test scalar-rowvalue-integral-real-first {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(3),(1),(2);
    SELECT (SELECT value FROM items ORDER BY value LIMIT 2.0);
}
expect {1}

test scalar-rowvalue-null-limit-rejected {
    SELECT (SELECT 2 LIMIT NULL);
}
expect error {datatype mismatch}

test scalar-rowvalue-fractional-limit-nonzero {
    SELECT (SELECT 2 LIMIT 1.5);
}
expect {2}

test scalar-rowvalue-nonnumeric-limit-nonzero {
    SELECT (SELECT 2 LIMIT 'invalid');
}
expect {2}

test scalar-rowvalue-grouped-first {
    CREATE TABLE items(category,value);
    INSERT INTO items VALUES(1,2),(1,3),(2,4);
    SELECT (SELECT sum(value) FROM items GROUP BY category ORDER BY category LIMIT abs(2));
}
expect {5}

test scalar-rowvalue-distinct-offset {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(1),(1),(2),(3);
    SELECT (SELECT DISTINCT value FROM items ORDER BY value LIMIT abs(2) OFFSET 1);
}
expect {2}

test scalar-rowvalue-zero-aggregate {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(1),(2);
    SELECT typeof((SELECT count(*) FROM items LIMIT abs(0)));
}
expect {null}

test update-rowvalue-dynamic-zero {
    CREATE TABLE pairs(identifier PRIMARY KEY,left_value,right_value);
    INSERT INTO pairs VALUES(1,10,20);
    UPDATE pairs SET (left_value,right_value)=(SELECT 2,3 LIMIT abs(0));
    SELECT left_value IS NULL,right_value IS NULL FROM pairs;
}
expect {1|1}

test update-rowvalue-dynamic-first-offset {
    CREATE TABLE pairs(identifier PRIMARY KEY,left_value,right_value);
    CREATE TABLE items(value);
    INSERT INTO pairs VALUES(1,10,20);
    INSERT INTO items VALUES(3),(1),(2);
    UPDATE pairs SET (left_value,right_value)=(SELECT value,value+10 FROM items ORDER BY value LIMIT abs(2) OFFSET 1);
    SELECT left_value,right_value FROM pairs;
}
expect {2|12}

test scalar-rowvalue-literal-first-control {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(3),(1),(2);
    SELECT (SELECT value FROM items ORDER BY value LIMIT 100);
}
expect {1}

test scalar-rowvalue-blob-limit-nonzero {
    SELECT (SELECT 2 LIMIT x'30');
}
expect {2}

test scalar-rowvalue-text-real-zero {
    SELECT typeof((SELECT 2 LIMIT '0.0'));
}
expect {null}

test scalar-rowvalue-text-whitespace-zero {
    SELECT typeof((SELECT 2 LIMIT ' 0 '));
}
expect {null}

test scalar-rowvalue-comparison-preserves-text {
    SELECT typeof('0'),typeof((SELECT 2 LIMIT '0')),typeof('0');
}
expect {text|null|text}

test scalar-rowvalue-large-heap-offset {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(5),(3),(1),(4),(2);
    SELECT (SELECT value FROM items ORDER BY value LIMIT abs(100) OFFSET abs(2));
}
expect {3}

test scalar-rowvalue-no-limit-first-control {
    CREATE TABLE items(value);
    INSERT INTO items VALUES(3),(1),(2);
    SELECT (SELECT value FROM items ORDER BY value);
}
expect {1}

