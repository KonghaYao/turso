test offset-correlated-counter-reset {
    CREATE TABLE items(value); INSERT INTO items VALUES(1),(2),(3); SELECT outer_items.value,coalesce((SELECT inner_items.value FROM items AS inner_items WHERE inner_items.value>=outer_items.value ORDER BY inner_items.value LIMIT abs(2) OFFSET abs(1)),-1) FROM items AS outer_items ORDER BY outer_items.value;
}
expect {1|2
2|3
3|-1}

