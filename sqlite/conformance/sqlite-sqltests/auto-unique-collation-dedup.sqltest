test r21-different-conflict-different-collation-index-count {
    CREATE TABLE t(a TEXT,b,UNIQUE(a) ON CONFLICT IGNORE,UNIQUE(a COLLATE NOCASE) ON CONFLICT FAIL);
    SELECT count(*) FROM sqlite_schema WHERE type='index' AND tbl_name='t';
}
expect {
    2
}

test r21-different-conflict-different-collation-enforcement {
    CREATE TABLE t(a TEXT,b,UNIQUE(a) ON CONFLICT IGNORE,UNIQUE(a COLLATE NOCASE) ON CONFLICT FAIL);
    INSERT INTO t VALUES('a',1);
    INSERT INTO t VALUES('A',2);
}
expect error {
    UNIQUE constraint failed: .*
}

test r21-different-conflict-same-key-enforcement {
    CREATE TABLE t(a TEXT,b,UNIQUE(a) ON CONFLICT IGNORE,UNIQUE(a) ON CONFLICT FAIL);
}
expect error {
    conflicting ON CONFLICT clauses specified
}

test r21-insert-ignore-retains-rows {
    CREATE TABLE t(a TEXT PRIMARY KEY,b,UNIQUE(a COLLATE NOCASE));
    INSERT INTO t VALUES('a',1),('b',2);
    INSERT OR IGNORE INTO t VALUES('A',3);
    SELECT a||':'||b FROM t ORDER BY b;
}
expect {
    a:1
    b:2
}

test r21-update-ignore-retains-rows {
    CREATE TABLE t(a TEXT PRIMARY KEY,b,UNIQUE(a COLLATE NOCASE));
    INSERT INTO t VALUES('a',1),('b',2);
    UPDATE OR IGNORE t SET a='A' WHERE b=2;
    SELECT a||':'||b FROM t ORDER BY b;
}
expect {
    a:1
    b:2
}

test r21-tuple-upsert-enforcement {
    CREATE TABLE t(a TEXT PRIMARY KEY,b INT UNIQUE,UNIQUE(a COLLATE NOCASE));
    INSERT INTO t VALUES('a',1),('b',2);
    INSERT INTO t VALUES('b',2) ON CONFLICT(b) DO UPDATE SET (a,b)=('A',2);
}
expect error {
    UNIQUE constraint failed: .*
}

test r21-nocase-upsert-target-updates-existing-row {
    CREATE TABLE t(a TEXT PRIMARY KEY,b INT,UNIQUE(a COLLATE NOCASE));
    INSERT INTO t VALUES('a',1);
    INSERT INTO t VALUES('A',2) ON CONFLICT(a COLLATE NOCASE) DO UPDATE SET b=excluded.b;
    SELECT quote(a),b FROM t;
}
expect {
    'a'|2
}

test r21-binary-upsert-target-does-not-catch-nocase-conflict {
    CREATE TABLE t(a TEXT PRIMARY KEY,b INT,UNIQUE(a COLLATE NOCASE));
    INSERT INTO t VALUES('a',1);
    INSERT INTO t VALUES('A',2) ON CONFLICT(a COLLATE BINARY) DO UPDATE SET b=excluded.b;
}
expect error {
    UNIQUE constraint failed: .*
}

test r21-declared-nocase-upsert-target-inherits-collation {
    CREATE TABLE t(a TEXT COLLATE NOCASE UNIQUE,b INT);
    INSERT INTO t VALUES('a',1);
    INSERT INTO t VALUES('A',2) ON CONFLICT(a) DO UPDATE SET b=excluded.b;
    SELECT quote(a),b FROM t;
}
expect {
    'a'|2
}

test r21-retained-desc-index-order {
    CREATE TABLE t(a TEXT,b,UNIQUE(a DESC),PRIMARY KEY(a ASC));
    PRAGMA index_xinfo(sqlite_autoindex_t_1);
}
expect {
    0|0|a|1|BINARY|1
    1|-1||0|BINARY|0
}

test r21-nc-rtrim-metadata {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE NOCASE),UNIQUE(x COLLATE RTRIM));
    PRAGMA index_list(t);
    PRAGMA index_xinfo(sqlite_autoindex_t_1);
    PRAGMA index_xinfo(sqlite_autoindex_t_2);
}
expect {
    0|sqlite_autoindex_t_2|1|u|0
    1|sqlite_autoindex_t_1|1|u|0
    0|0|x|0|NOCASE|1
    1|-1||0|BINARY|0
    0|0|x|0|RTRIM|1
    1|-1||0|BINARY|0
}

test r21-nc-rtrim-collision {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE NOCASE),UNIQUE(x COLLATE RTRIM));
    INSERT INTO t VALUES('a ','original');
    INSERT INTO t VALUES('a','duplicate');
}
expect error {
    UNIQUE constraint failed: t\.x
}

test r21-nc-rtrim-ignore-rows {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE NOCASE),UNIQUE(x COLLATE RTRIM));
    INSERT INTO t VALUES('a ','original');
    INSERT OR IGNORE INTO t VALUES('a','duplicate');
    SELECT quote(x)||':'||y FROM t ORDER BY rowid;
}
expect {
    'a ':original
}

test r21-rtrim-nc-metadata {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE RTRIM),UNIQUE(x COLLATE NOCASE));
    PRAGMA index_list(t);
    PRAGMA index_xinfo(sqlite_autoindex_t_1);
    PRAGMA index_xinfo(sqlite_autoindex_t_2);
}
expect {
    0|sqlite_autoindex_t_2|1|u|0
    1|sqlite_autoindex_t_1|1|u|0
    0|0|x|0|RTRIM|1
    1|-1||0|BINARY|0
    0|0|x|0|NOCASE|1
    1|-1||0|BINARY|0
}

test r21-rtrim-nc-collision {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE RTRIM),UNIQUE(x COLLATE NOCASE));
    INSERT INTO t VALUES('A','original');
    INSERT INTO t VALUES('a','duplicate');
}
expect error {
    UNIQUE constraint failed: t\.x
}

test r21-rtrim-nc-ignore-rows {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE RTRIM),UNIQUE(x COLLATE NOCASE));
    INSERT INTO t VALUES('A','original');
    INSERT OR IGNORE INTO t VALUES('a','duplicate');
    SELECT quote(x)||':'||y FROM t ORDER BY rowid;
