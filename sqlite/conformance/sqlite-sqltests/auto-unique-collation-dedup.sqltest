@database :memory:

test r21-pk-auto-nocase-index-count {
    CREATE TABLE t(a TEXT PRIMARY KEY,b INT UNIQUE,UNIQUE(a COLLATE NOCASE));
    SELECT count(*) FROM sqlite_schema WHERE type='index' AND tbl_name='t';
}
expect {
    3
}

test r21-pk-auto-nocase-enforcement {
    CREATE TABLE t(a TEXT PRIMARY KEY,b INT UNIQUE,UNIQUE(a COLLATE NOCASE));
    INSERT INTO t VALUES('a',1),('b',2);
    INSERT INTO t VALUES('b',2) ON CONFLICT(b) DO UPDATE SET a='A';
}
expect error {
    UNIQUE constraint failed: .*
}

test r21-pk-only-index-count {
    CREATE TABLE t(a TEXT PRIMARY KEY,b INT UNIQUE);
    SELECT count(*) FROM sqlite_schema WHERE type='index' AND tbl_name='t';
}
expect {
    2
}

test r21-pk-only-enforcement {
    CREATE TABLE t(a TEXT PRIMARY KEY,b INT UNIQUE);
    INSERT INTO t VALUES('a',1),('b',2);
    UPDATE t SET a='a' WHERE b=2;
}
expect error {
    UNIQUE constraint failed: .*
}

test r21-same-binary-index-count {
    CREATE TABLE t(a TEXT PRIMARY KEY,b,UNIQUE(a COLLATE BINARY));
    SELECT count(*) FROM sqlite_schema WHERE type='index' AND tbl_name='t';
}
expect {
    1
}

test r21-same-binary-enforcement {
    CREATE TABLE t(a TEXT PRIMARY KEY,b,UNIQUE(a COLLATE BINARY));
    INSERT INTO t VALUES('a',1);
    INSERT INTO t VALUES('A',2);
    SELECT quote(a)||':'||quote(b) FROM t ORDER BY rowid;
}
expect {
    'a':1
    'A':2
}

