test r21-nc-rtrim-abort-collision {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE NOCASE),UNIQUE(x COLLATE RTRIM));
    INSERT INTO t VALUES('a ','original');
    BEGIN;
    INSERT INTO t VALUES('z','before-statement');
    INSERT OR ABORT INTO t VALUES('b','before-conflict'),('a','conflict'),('c','after-conflict');
}
expect error {
    UNIQUE constraint failed: t\.x
}

test r21-nc-rtrim-fail-collision {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE NOCASE),UNIQUE(x COLLATE RTRIM));
    INSERT INTO t VALUES('a ','original');
    BEGIN;
    INSERT INTO t VALUES('z','before-statement');
    INSERT OR FAIL INTO t VALUES('b','before-conflict'),('a','conflict'),('c','after-conflict');
}
expect error {
    UNIQUE constraint failed: t\.x
}

test r21-nocase-duplicate-pk-ownership {
    CREATE TABLE t(x TEXT COLLATE NOCASE,y,UNIQUE(x),UNIQUE(x COLLATE NOCASE),PRIMARY KEY(x));
    PRAGMA index_list(t);
    PRAGMA index_xinfo(sqlite_autoindex_t_1);
}
expect {
    0|sqlite_autoindex_t_1|1|pk|0
    0|0|x|0|NOCASE|1
    1|-1||0|BINARY|0
}
