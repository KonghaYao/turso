test r21-same-nocase-ignore-rows {
    CREATE TABLE t(x TEXT,y TEXT,UNIQUE(x COLLATE NOCASE),UNIQUE(x COLLATE NOCASE));
    INSERT INTO t VALUES('A','original');
    INSERT OR IGNORE INTO t VALUES('a','duplicate');
