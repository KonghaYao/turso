test metadata-rtrim-function-no-implicit {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('ABC','ABC','abc ');SELECT x='abc' FROM (SELECT coalesce(r,'') AS x FROM t);
