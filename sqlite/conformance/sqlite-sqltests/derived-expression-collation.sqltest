@database :memory:

test derived-column-left {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT x='abc' FROM (SELECT n AS x FROM t) AS v;
}
expect {
    1
}

test derived-column-right {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT 'abc'=x FROM (SELECT n AS x FROM t) AS v;
}
expect {
    1
}

test derived-column-cast {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT +CAST(x AS TEXT)='abc' FROM (SELECT n AS x FROM t) AS v;
}
expect {
    1
}

test derived-column-explicit-right {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT x='abc' COLLATE binary FROM (SELECT n AS x FROM t) AS v;
}
expect {
    0
}

test view-column-left {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');CREATE VIEW v AS SELECT n AS x FROM t;SELECT x='abc' FROM v;
}
expect {
    1
}

test view-column-right {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');CREATE VIEW v AS SELECT n AS x FROM t;SELECT 'abc'=x FROM v;
}
expect {
    1
}

