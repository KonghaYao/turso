test oracle9-materialized-cte-function {
    CREATE TABLE t(n TEXT COLLATE nocase);INSERT INTO t VALUES('ABC');WITH v AS MATERIALIZED (SELECT coalesce(n,'') AS x FROM t) SELECT x='abc' FROM v;
}
expect {
    0
}

