    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');CREATE VIEW v AS SELECT n AS x FROM t;SELECT x='abc' COLLATE binary FROM v;
