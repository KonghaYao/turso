test metadata-compound-first-nocase {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('ABC','ABC','abc ');SELECT x='abc' FROM (SELECT n AS x FROM t UNION ALL SELECT b AS x FROM t);
}
expect {
    1
    1
}

test metadata-compound-first-binary {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('ABC','ABC','abc ');SELECT x='abc' FROM (SELECT b AS x FROM t UNION ALL SELECT n AS x FROM t);
}
expect {
    0
    0
}

test metadata-affinity-preserved {
    CREATE TABLE a(i INTEGER,n TEXT COLLATE nocase);INSERT INTO a VALUES(7,'ABC');SELECT x='7',typeof(x),y='abc' FROM (SELECT i AS x,coalesce(n,'') AS y FROM a);
}
expect {
    1|integer|0
}
