    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');CREATE VIEW v AS SELECT n AS x FROM t;SELECT +CAST(x AS TEXT)='abc' FROM v;
}
expect {
