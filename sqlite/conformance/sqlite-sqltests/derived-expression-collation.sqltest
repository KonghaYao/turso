    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT coalesce(n,'') AS x FROM t WHERE x='abc';
}
expect {
}

