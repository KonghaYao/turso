test indexed-nocase-result {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');CREATE INDEX idx_n ON t(n); SELECT n FROM t INDEXED BY idx_n WHERE n='abc';
}
expect {
    ABC
}

test indexed-binary-negative {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');CREATE INDEX idx_n ON t(n); SELECT n FROM t INDEXED BY idx_n WHERE n COLLATE binary='abc';
}
expect {
}

test indexed-comparison-projection {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');CREATE INDEX idx_n ON t(n); SELECT n='abc',n COLLATE binary='abc' FROM t INDEXED BY idx_n;
}
expect {
    1|0
}

test group-cache-function-binary-negative {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT coalesce(n,'')='abc' FROM t GROUP BY coalesce(n,'');
}
expect {
    0
}

test group-cache-explicit-nocase-positive {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT (coalesce(n,'') COLLATE nocase)='abc' FROM t GROUP BY coalesce(n,'') COLLATE nocase;
}
expect {
    1
}

test oracle9-derived-column {
    CREATE TABLE t(n TEXT COLLATE nocase);INSERT INTO t VALUES('ABC');SELECT x='abc' FROM (SELECT n AS x FROM t);
}
expect {
    1
}

test oracle9-derived-cast-column {
    CREATE TABLE t(n TEXT COLLATE nocase);INSERT INTO t VALUES('ABC');SELECT x='abc' FROM (SELECT CAST(n AS TEXT) AS x FROM t);
}
expect {
    1
}

test oracle9-derived-function {
    CREATE TABLE t(n TEXT COLLATE nocase);INSERT INTO t VALUES('ABC');SELECT x='abc' FROM (SELECT coalesce(n,'') AS x FROM t);
}
expect {
    0
}

test oracle9-derived-concat {
    CREATE TABLE t(n TEXT COLLATE nocase);INSERT INTO t VALUES('ABC');SELECT x='abc' FROM (SELECT n||'' AS x FROM t);
}
expect {
    0
}

test oracle9-derived-case {
    CREATE TABLE t(n TEXT COLLATE nocase);INSERT INTO t VALUES('ABC');SELECT x='abc' FROM (SELECT CASE WHEN 1 THEN n ELSE '' END AS x FROM t);
}
expect {
    0
}

test oracle9-derived-explicit-function {
    CREATE TABLE t(n TEXT COLLATE nocase);INSERT INTO t VALUES('ABC');SELECT x='abc' FROM (SELECT coalesce(n COLLATE nocase,'') AS x FROM t);
}
expect {
    1
}

