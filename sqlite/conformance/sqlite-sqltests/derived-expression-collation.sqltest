test alias-explicit-nocase-over-right-binary {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT n COLLATE nocase AS x FROM t WHERE x='abc' COLLATE binary;
}
expect {
    ABC
}

test alias-explicit-binary-over-column {
    CREATE TABLE t(b TEXT,n TEXT COLLATE nocase,r TEXT COLLATE rtrim); INSERT INTO t VALUES('abc','ABC','abc ');SELECT n COLLATE binary AS x FROM t WHERE x='abc';
}
expect {
}

