@database :memory:
@requires-file trigger "requires triggers"

test official-insert-17-5-17-8 {
    PRAGMA temp.recursive_triggers = true;
    CREATE TABLE t2(a INTEGER PRIMARY KEY, b);
    CREATE UNIQUE INDEX t2b ON t2(b);
    INSERT INTO t2(a,b) VALUES(1,1),(2,2),(3,3),(4,4);
    CREATE TABLE fire(x);
    CREATE TRIGGER t2r1 AFTER DELETE ON t2 BEGIN
      INSERT INTO fire VALUES(old.a);
    END;
    UPDATE OR REPLACE t2 SET a=4, b=3 WHERE a=1;
    SELECT *, 'x' FROM t2 ORDER BY a;
    SELECT x FROM fire ORDER BY x;
    DELETE FROM t2;
    DELETE FROM fire;
    INSERT INTO t2(a,b) VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE OR REPLACE t2 SET a=1, b=3 WHERE a=1;
    SELECT *, 'x' FROM t2 ORDER BY a;
    SELECT x FROM fire ORDER BY x;
}
expect {
    2|2|x
    4|3|x
    3
    4
    1|3|x
    2|2|x
    4|4|x
    3
}

test update-replace-recursive-default-off {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b UNIQUE);
    CREATE TABLE fire(x);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN INSERT INTO fire VALUES(old.a); END;
    INSERT INTO t VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE OR REPLACE t SET a=4,b=3 WHERE a=1;
    SELECT * FROM t ORDER BY a;
    SELECT count(*) FROM fire;
    PRAGMA integrity_check;
}
expect {
    2|2
    4|3
    0
    ok
}

test update-replace-delete-trigger-order {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY, b UNIQUE);
    CREATE TABLE fire(x);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN INSERT INTO fire VALUES(old.a); END;
    INSERT INTO t VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE OR REPLACE t SET a=4,b=3 WHERE a=1;
    SELECT x FROM fire ORDER BY rowid;
    PRAGMA integrity_check;
}
expect {
    4
    3
    ok
}

test update-replace-after-delete-restores-rowid-abort {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY, b UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN INSERT INTO t VALUES(old.a,9); END;
    UPDATE OR REPLACE t SET a=2,b=3 WHERE a=1;
}
expect error { UNIQUE constraint failed: t.a }

test update-replace-unique-delete-cannot-write-source {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY, b UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2),(3,3);
    CREATE TRIGGER tr AFTER DELETE ON t WHEN old.a=2 BEGIN DELETE FROM t WHERE a=1; END;
    UPDATE OR REPLACE t SET b=2 WHERE a=1;
}
expect error { constraint failed }

test update-replace-unique-delete-when-false {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY,b UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2);
    CREATE TRIGGER tr AFTER DELETE ON t WHEN 0 BEGIN DELETE FROM t WHERE a=1; END;
    UPDATE OR REPLACE t SET b=2 WHERE a=1;
    SELECT * FROM t ORDER BY a;
    PRAGMA integrity_check;
}
expect {
    1|2
    ok
}

test update-replace-unique-delete-insert-guard {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY,b UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN INSERT INTO t VALUES(9,9); END;
    UPDATE OR REPLACE t SET b=2 WHERE a=1;
}
expect error { constraint failed }

test update-replace-unique-delete-update-guard {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY,b UNIQUE,c);
    INSERT INTO t VALUES(1,1,'source'),(2,2,'victim');
    CREATE TRIGGER tr BEFORE DELETE ON t BEGIN UPDATE t SET c='changed' WHERE a=old.a; END;
    UPDATE OR REPLACE t SET b=2 WHERE a=1;
}
expect error { constraint failed }

test update-replace-unique-delete-no-mutation {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY,b UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN SELECT count(*) FROM t; UPDATE t SET b=9 WHERE 0; END;
    UPDATE OR REPLACE t SET b=2 WHERE a=1;
    SELECT * FROM t ORDER BY a;
    PRAGMA integrity_check;
}
expect {
    1|2
    ok
}

test update-replace-before-delete-current-index-keys {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY, b UNIQUE, c);
    CREATE INDEX tc ON t(c) WHERE c>0;
    CREATE TABLE fire(x,y);
    INSERT INTO t VALUES(1,1,1),(2,2,2);
    CREATE TRIGGER tb BEFORE DELETE ON t BEGIN UPDATE t SET b=20,c=-1 WHERE a=old.a; END;
    CREATE TRIGGER ta AFTER DELETE ON t BEGIN INSERT INTO fire VALUES(old.b,old.c); END;
    UPDATE OR REPLACE t SET a=2,b=9 WHERE a=1;
    SELECT * FROM t ORDER BY a;
    SELECT * FROM fire;
    PRAGMA integrity_check;
}
expect {
    2|9|1
    2|2
    ok
}

test update-replace-delete-trigger-removes-source {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY, b UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2),(3,3);
    CREATE TRIGGER tr AFTER DELETE ON t WHEN old.a=2 BEGIN DELETE FROM t WHERE a=1; END;
    UPDATE OR REPLACE t SET a=2,b=9 WHERE a=1;
    SELECT * FROM t ORDER BY a;
    PRAGMA integrity_check;
}
expect {
    3|3
    ok
}

test update-replace-fk-delete-restores-unique-abort {
    PRAGMA foreign_keys=ON;
    CREATE TABLE p(a INTEGER PRIMARY KEY,b UNIQUE);
    CREATE TABLE c(a,b REFERENCES p(b) ON DELETE CASCADE);
    INSERT INTO p VALUES(1,1),(2,2);
    INSERT INTO c VALUES(9,2);
    CREATE TRIGGER tr AFTER DELETE ON c BEGIN INSERT INTO p VALUES(3,2); END;
    UPDATE OR REPLACE p SET b=2 WHERE a=1;
}
expect error { UNIQUE constraint failed: p.b }

test update-replace-before-delete-ignore-late-abort {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY,b UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2);
    CREATE TRIGGER tr BEFORE DELETE ON t BEGIN SELECT RAISE(IGNORE); END;
    UPDATE OR REPLACE t SET b=2 WHERE a=1;
}
expect error { UNIQUE constraint failed: t.b }

test update-replace-rowid-without-secondary-index {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY);
    INSERT INTO t VALUES(1),(2);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN INSERT INTO t VALUES(old.a); END;
    UPDATE OR REPLACE t SET a=2 WHERE a=1;
}
expect error { UNIQUE constraint failed: t.a }

test update-ddl-replace-delete-trigger-conflict-policy {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY,b UNIQUE ON CONFLICT REPLACE);
    CREATE TABLE fire(x UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2);
    INSERT INTO fire VALUES(2);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN INSERT INTO fire VALUES(old.a); END;
    UPDATE t SET b=2 WHERE a=1;
    SELECT * FROM t ORDER BY a;
    SELECT * FROM fire;
    PRAGMA integrity_check;
}
expect {
    1|2
    2
    ok
}

test update-then-explicit-delete-conflict-policy-reset {
    PRAGMA recursive_triggers=ON;
    CREATE TABLE t(a INTEGER PRIMARY KEY,b UNIQUE ON CONFLICT REPLACE);
    CREATE TABLE fire(x UNIQUE);
    INSERT INTO t VALUES(1,1),(2,2);
    INSERT INTO fire VALUES(2);
    CREATE TRIGGER tr AFTER DELETE ON t BEGIN INSERT INTO fire VALUES(2); END;
    UPDATE OR REPLACE t SET b=2 WHERE a=1;
    DELETE FROM t WHERE a=1;
}
expect error { UNIQUE constraint failed: fire.x }
