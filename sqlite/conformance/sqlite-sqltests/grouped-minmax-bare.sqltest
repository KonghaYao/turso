test mixed-types-indexed {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,2,2),(1,2.5,3),(1,'3',4),(1,X'33',5); CREATE INDEX ta ON t(a); SELECT a,typeof(max(b)),hex(max(b)),c,rowid FROM t GROUP BY a ORDER BY a;
}
expect {
1|blob|33|5|4
