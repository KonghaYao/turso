    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,2,2),(1,1,3); CREATE INDEX ta ON t(a); SELECT a,max(b) FILTER(WHERE 0),min(b),c,rowid FROM t GROUP BY a ORDER BY a;
