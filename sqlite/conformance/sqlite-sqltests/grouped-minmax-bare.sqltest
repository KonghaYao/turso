    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,NULL,2),(1,2,3),(1,1,4); CREATE INDEX ta ON t(a); SELECT a,min(b),max(c) FILTER(WHERE c=3),c,rowid FROM t GROUP BY a ORDER BY a;
}
