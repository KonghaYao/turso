test empty-groups-indexed {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,2,2); CREATE INDEX ta ON t(a); SELECT a,max(b),c,rowid FROM t WHERE c<0 GROUP BY a ORDER BY a;
}
expect {

}

test plain-count-indexed {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,2,2),(1,3,3); CREATE INDEX ta ON t(a); SELECT a,count(*),c,rowid FROM t GROUP BY a ORDER BY a;
}
expect {
1|2|2|1
}

test no-bare-indexed {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,NULL,2),(1,2,3),(1,1,4); CREATE INDEX ta ON t(a); SELECT a,min(b),max(b) FROM t GROUP BY a ORDER BY a;
}
expect {
1|1|2
}

test having-bare {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES(1,NULL,2),(1,2,3),(1,1,4),(2,NULL,5),(2,3,6); SELECT a,max(b),c FROM t GROUP BY a HAVING c=3 ORDER BY a;
}
expect {
1|2|3
}

test order-bare {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES(1,NULL,2),(1,2,3),(1,1,4),(2,NULL,5),(2,3,6); SELECT a,max(b) FROM t GROUP BY a ORDER BY c;
}
expect {
1|2
2|3
}

test mixed-result {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES(1,NULL,2),(1,2,3),(1,1,4),(2,NULL,5),(2,3,6); SELECT a,max(b)+c FROM t GROUP BY a ORDER BY a;
}
expect {
1|5
2|9
}

test group-expression {
    CREATE TABLE t(a,b,c); INSERT INTO t VALUES(1,NULL,2),(1,2,3),(1,1,4),(2,NULL,5),(2,3,6); SELECT max(b),c,rowid FROM t GROUP BY a%2 ORDER BY a%2;
}
expect {
3|6|5
2|3|2
}
