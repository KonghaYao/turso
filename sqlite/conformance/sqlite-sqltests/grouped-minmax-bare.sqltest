    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,NULL,2),(1,NULL,3),(1,NULL,4); CREATE INDEX ta ON t(a); SELECT a,max(DISTINCT b),c,rowid FROM t GROUP BY a ORDER BY a;
