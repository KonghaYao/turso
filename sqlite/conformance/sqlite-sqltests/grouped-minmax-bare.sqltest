    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,NULL,2),(1,2,3),(1,2,4),(1,1,5); CREATE INDEX ta ON t(a); SELECT a,max(DISTINCT b) FILTER(WHERE c>2),c,rowid FROM t GROUP BY a ORDER BY a;
