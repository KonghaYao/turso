    CREATE TABLE t(a,b,c); INSERT INTO t VALUES (1,2,2),(1,2,3),(1,1,4); CREATE INDEX ta ON t(a); SELECT a,max(b),c,rowid FROM t GROUP BY a ORDER BY a;
}
